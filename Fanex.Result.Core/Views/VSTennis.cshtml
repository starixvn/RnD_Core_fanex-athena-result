@{
    var lang = (Fanex.Result.Core.DTO.LangResources)Model.Resource;
    const int colspan = 4;
}
<table class="fanex-result">
    <thead>
        @if (Model.IsShowPopUpTitle && Model.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.VSTennisViewModel)Model.Data[0];
            <tr class="row-title">
                <th class="column-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp;
                    <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="row-header">
            <th class="column-kickofftime">
                @lang.KickOffTime
            </th>
            <th class="column-match">
                @Raw(lang.Match)
            </th>
            <th class="column-totalpoint">
                @Raw(lang.TotalPoints)
            </th>
            <th class="column-status">
                @lang.Status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in Model.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.VSTennisViewModel)itemObj;
                index++;
                if (!Model.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;

            <tr class="row-data">
                <td colspan="@colspan" class="column-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-kickofftime" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="column-match">
                    @Raw(item.HomeTeam)
                </td>
                <td class="column-home-totalpoint">
                    @item.HomePoint
                </td>
                <td rowspan="2" class="column-eventstatus">
                    @item.EventStatus
                </td>
            </tr>
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-match">
                    @Raw(item.AwayTeam)
                </td>
                <td class="column-away-totalpoint">
                    @item.AwayPoint
                </td>
            </tr>
            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @Model.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>