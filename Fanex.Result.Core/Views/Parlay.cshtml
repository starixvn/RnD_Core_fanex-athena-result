@{
    var lang = (Fanex.Result.Core.DataDomain.LangResources)Model.Resource;
}
@if (Model.Data.Count > 0)
{ 
    <table class="fn-rs-popup" cellpadding="0" cellspacing="0">
        @foreach (var itemObj in Model.Data)
        {
            var item = (Fanex.Result.Core.ViewModels.ParlayViewModel)itemObj;
            <tr>
                <td class="sporttype">
                    <strong><span class="bl-sport-type">@item.SportName &nbsp;- </span></strong><span
                        class="bl-league-name">@item.LeagueName</span>
                </td>
            </tr>
            <tr>
                <td>
                    @{
            var bindModle = new Fanex.Result.Core.Models.RazorBinderModel
            {
                Resource = lang,
                IsPopUp = true,
                IsParlay = true,
            };
            bindModle.Data.AddRange(item.ItemView);
                    }
                    @Raw(item.Render(bindModle))
                </td>
            </tr>
        }
    </table>
}