<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
    <TargetFrameworks>net461;netstandard2.1;net7.0</TargetFrameworks>
    <PackageId>Fanex.Result.Core.AllBetCasino</PackageId> 
    <OutputType>Library</OutputType>    
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>    
    <AssemblyTitle>Fanex.Result.Core.AllBetCasino</AssemblyTitle>
    <Product>Fanex.Result.Core.AllBetCasino</Product>
    <Copyright>Copyright ©  2016</Copyright>    
    <Version>2.0.0.3-jp-01</Version>
    <InfomationalVersion>2.0.0.3</InfomationalVersion>
    <PackageReleaseNotes>Support Japanese Translation (#212931)</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>    
    <PackageReference Include="Fanex.Result.Core-NPOI.2.0.6" Version="3.0.0.5" />    
    <PackageReference Include="Fanex.Result.Core.ConfigurationHelper" Version="1.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>  
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\AllbetResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AllbetResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\AllbetResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AllbetResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>