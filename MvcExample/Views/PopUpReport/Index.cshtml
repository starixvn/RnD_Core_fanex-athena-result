@{
    ViewBag.Title = "Fanex.Result.Core - Popup report.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Fanex.Result.3rdLiveCasino/css/table_w.css" rel="stylesheet" />
@section Headline {
    <ul class="breadcrumb title">
        <li>Demo</li>
        <li class="current">PopUp</li>
        <li class="current" style="cursor: pointer;" id="parlay-mode">[Parlay]</li>
        <li class="current" style="cursor: pointer;" id="sb-mode">[Sportbook]</li>
        <li class="current" style="cursor: pointer;" id="racing-mode">[Racing]</li>
    </ul>
}
<form role="form" action="/" class="form-inline col-sm-8 filter-form bet-setting">
    <div class="form-group">
        <label for="date">
            Date
        </label>
        <input id="date" class="width-160" type="text" />
    </div>
    <div class="form-group">
        <label for="sport">
            Sport
        </label>
        <select id="sport" class="width-100"></select>
    </div>
    <div class="form-group">
        <label for="league">
            Bettype
        </label>
        <select id="bettype" class="width-100">
            <option value="1">Handicap </option>
            <option value="9">Parlay </option>
            <option value="29">System Parlay </option>
            <option value="3">Over/Under </option>
            <option value="4">Correct Score </option>
            <option value="10">Outright</option>
            <option value="20">Moneyline </option>
            <option value="31">Win </option>
            <option value="32">Place </option>
            <option value="41">Win.UK Tote </option>
            <option value="43">Win/Place.UK Tote </option>
            <option value="5">FT.1X2 </option>
            <option value="1324">TennisSetXGameY</option>
            <option value="1701">Baccarat</option>
            <option value="1702">Roulette</option>
            <option value="1703">Parlay Baccarat</option>
            <option value="801">Metric Gaming 801</option>
            <option value="2401">Allbet - Baccarat</option>
            <option value="2403">Allbet - Roulette</option>
            <option value="2404">Allbet - SicBo</option>
            <option value="2405">Allbet - DragonTiger</option>
        </select>
    </div>
    <div class="form-group">
        <label for="league">
            MatchId
        </label>
        <input type="text" id="matchid" value="" class="width-100" />
    </div>
    <div class="form-group">
        <label for="betid">
            BetId
        </label>
        <input type="text" id="betid" value="" class="width-40" />
    </div>
    <div class="form-group">
        <label for="league">
            RaceNo
        </label>
        <input type="text" id="raceno" value="" class="width-100" />
    </div>
    <div class="form-group">
        <label for="league">
            RefNo
        </label>
        <input id="refno" type="text" value="" class="width-100" />
    </div>
    <div class="form-group">
        <label for="league">
            OutRight
        </label>
        <input id="isoutright" type="checkbox" />
    </div>
    <div class="form-group">
        <label for="Language">Language</label>
        <select id="language" class="width-100">
            <option value="en-US">en-US</option>
            <option value="ko-KR">ko-KR</option>
            <option value="zh-TW">zh-TW</option>
            <option value="zh-CN">zh-CN</option>
        </select>
    </div>
    <div class="form-group">
        <input type="button" id="gen-html" value="Gen Html" class="btn-primary" />
    </div>
</form>
<div id="report-content" class="col-sm-8">
</div>
@section FooterJs
{
    <script type="text/javascript">
        $(document).ready(function () {
            popupReport.setup();
        });
    </script>
}