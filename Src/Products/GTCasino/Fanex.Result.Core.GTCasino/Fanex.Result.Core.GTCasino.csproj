<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  <TargetFrameworks>netstandard2.1;net7.0</TargetFrameworks> 
    <OutputType>Library</OutputType>
    <RestorePackages>true</RestorePackages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Fanex.Result.Core.GTCasino</AssemblyTitle>
    <Product>Fanex.Result.Core.GTCasino</Product>
    <Copyright>Copyright ©  2020</Copyright>
    <Version>3.0.0.0-upgrade-01</Version>
    <InfomationalVersion>3.0.0.0</InfomationalVersion>
    <PackageReleaseNotes>Support .net Core for Result Core package (#191539)</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="Resource\GTCasinoResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GTCasinoResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resource\GTCasinoResource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>GTCasinoResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Result.Core-NPOI.2.0.6" Version="4.0.0-upgrade-03" />
  </ItemGroup>
</Project>