@using Fanex.Result.Core.Base;
@using Fanex.Result.Core.Base.ViewModels;
@using Fanex.Result.Core.Sportsbook.ViewModels;
@{
    var viewModel = (RazorBinderModel)Model;
}
@if (viewModel != null && viewModel.Data.Count > 0)
{
    <table class="fn-rs-popup parlay">
        @foreach (var group in viewModel.Data)
        {
            var firstItem = group.Data[0];
            <tr>
                <td class="sporttype">
                    <strong><span class="bl-sport-type">@firstItem.SportName&nbsp;-&nbsp;</span></strong>
                    <span class="bl-league-name">@firstItem.LeagueName</span>
                </td>
            </tr>

            foreach (ParlayViewModel item in group.Data)
            {
                <tr>
                    <td>
                        @{
                            var sportType = (SportType)item.SportId;

                            var bindModel = new RazorBinderModel
                            {
                                IsPopUp = true,
                                VisibleMatchCodeIDColumn = viewModel.VisibleMatchCodeIDColumn,
                                SportType = sportType
                            };
                        }
                        <!--Only render Match result-->
                        @if (item.MatchItemView.Count > 0)
                        {
                            bindModel.Data.Add(new GroupData
                            {
                                LeagueId = group.LeagueId,
                                Data = item.MatchItemView
                            });
                            @Raw(item.Render(bindModel))
                            <br />
                        }
                        <!--Render both match and detail game-->
                        @foreach (var bothMatchAndGame in item.BothMatchAndDetailItemView)
                        {
                            var bothMatchAnddetailBindModel = new RazorBinderModel
                            {

                                IsPopUp = true,
                                VisibleMatchCodeIDColumn = viewModel.VisibleMatchCodeIDColumn,
                                SportType = sportType,
                                IsDetail = true
                            };

                            var bothMatchAnddetailItem = new GroupData
                            {
                                LeagueId = group.LeagueId,
                            };

                            bothMatchAnddetailItem.Data.Add(bothMatchAndGame);
                            bothMatchAnddetailBindModel.Data.Add(bothMatchAnddetailItem);
                            @Raw(item.Render(bothMatchAnddetailBindModel))
                            <br />
                        }
                        @foreach (var gameItemView in item.GameDetailItemView)
                        {
                            var detailBindModel = new RazorBinderModel
                            {
                                IsPopUp = true,
                                VisibleMatchCodeIDColumn = viewModel.VisibleMatchCodeIDColumn,
                                SportType = sportType
                            };

                            var detailGameItem = new GroupData
                            {
                                LeagueId = group.LeagueId,
                            };

                            detailGameItem.Data.Add(gameItemView);
                            detailBindModel.Data.Add(detailGameItem);

                            @Raw(item.Render(detailBindModel))
                            <br />
                        }
                    </td>
                </tr>
            }
        }
    </table>
}