@{
    var viewModel = (Fanex.Result.Core.Models.RazorBinderModel)Model;

    var lang = (Fanex.Result.Core.DTO.LangResources)viewModel.Resource;
    var colspan = viewModel.IsShowMatchCodeAndId ? 11 : 10;
}
<table class="fanex-result">
    <colgroup>
        @if (viewModel.IsShowMatchCodeAndId)
        {
            <col class="column-matchcode" />

        }
        <col class="column-kickofftime" />
        <col class="column-match" />
        <col class="column-q column-q1" />
        <col class="column-q column-q2" />
        <col class="column-q column-q3" />
        <col class="column-q column-q4" />
        <col class="column-q column-qt" />
        <col class="column-firsthaftscore" />
        <col class="column-finalscore" />
        <col class="column-status" />
    </colgroup>
    <thead>
        @if (viewModel.IsShowPopUpTitle && viewModel.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.BasketBallViewModel)viewModel.Data[0];
            <tr class="row-title">
                <th class="column-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="row-header">
            @if (viewModel.IsShowMatchCodeAndId)
            {
                <th class="column-matchcode">
                    @lang.MatchCode/@lang.ID
                </th>
            }
            <th class="column-kickofftime">
                @lang.KickOffTime
            </th>
            <th class="column-match">
                @Raw(lang.Match)
            </th>
            <th class="column-q column-q1">
                @lang.Lbl1Q
            </th>
            <th class="column-q column-q2">
                @lang.Lbl2Q
            </th>
            <th class="column-q column-q3">
                @lang.Lbl3Q
            </th>
            <th class="column-q column-q4">
                @lang.Lbl4Q
            </th>
            <th class="column-q column-qt">
                @lang.LblOT
            </th>
            <th class="column-firsthaftscore">
                @Raw(lang.FirstHalfScore)
            </th>
            <th class="column-finalscore">
                @lang.FinalScore
            </th>
            <th class="column-status">
                @lang.Status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in viewModel.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.BasketBallViewModel)itemObj;
                index++;
                if (!viewModel.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;
            <tr class="row-data">
                <td colspan="@colspan" class="column-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                @if (viewModel.IsShowMatchCodeAndId)
                {
                    <td class="column-matchcode">
                    <div class="m-code">
                            @item.MatchCode
                        </div>
                    </td>
                }
                <td class="column-kickofftime" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="column-match">
                    @Raw(item.HomeTeam)
                </td>
                <td>
                    @item.GetQHomeAway(0, true)
                </td>
                <td>
                    @item.GetQHomeAway(1, true)
                </td>
                <td>
                    @item.GetQHomeAway(2, true)
                </td>
                <td>
                    @item.GetQHomeAway(3, true)
                </td>
                <td>
                    @item.QTHome
                </td>
                <td class="column-ht-homescore">
                    @item.HTHomeScore
                </td>
                <td char="column-final-homescore">
                    @item.FinalHomeScore
                </td>
                <td rowspan="2" class="column-eventstatus">
                    @item.EventStatus
                </td>
            </tr>
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                @if (viewModel.IsShowMatchCodeAndId)
                {
                    <td class="column-matchcode">
                        @item.MatchId
                    </td>
                }
                <td class="column-match">
                    @Raw(item.AwayTeam)
                </td>
                <td>
                    @item.GetQHomeAway(0, false)
                </td>
                <td>
                    @item.GetQHomeAway(1, false)
                </td>
                <td>
                    @item.GetQHomeAway(2, false)
                </td>
                <td>
                    @item.GetQHomeAway(3, false)
                </td>
                <td>
                    @item.QTAway
                </td>
                <td class="column-ht-awayscore">
                    @item.HTAwayScore
                </td>
                <td class="column-ht-finalscore">
                    @item.FinalAwayScore
                </td>
            </tr>
            }
        }
        else
        {

            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>