@{
    var item = (Fanex.Result.Core.ViewModels.KenoViewModel)Model;
}
<div class="fanex-result-keno">
    <iframe id="fanex-result-keno-frame" src="@item.ResultUrl" frameborder="0" top="0" left="0" name="fanex-result-keno-frame">
    </iframe>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        setInterval(function () {
            $.post(self.location.href, { userId: '@item.LoginUserId' }).done(function (data) { if (data.length > 5) self.location.href = data; });
        }, 175000)
    });
</script>
