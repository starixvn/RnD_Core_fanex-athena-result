@using Fanex.Result.Core.Sportsbook.ViewModels.SoccerDetail;
@using Fanex.Result.Core.Sportsbook.DataDomain;

@{
    var itemViewModel = (SoccerDetailViewModel)Model;
}
<tr class="data cl-group-name">
    <td></td>
    <td colspan="2">@itemViewModel.Name</td>
</tr>
@foreach (var item in itemViewModel.DetailItems)
{
    for (int i = 0; i < item.TimeRange.Count; i++)
    {
        if (item.ResourceID == GameResourceID.TimeMachineHDPStatus)
        {
            <tr class="data">
                <td class="cl-match">@item.TimeRange[i]</td>
                <td class="cl-result home">
                    @item.HomeValue
                </td>
                <td class="cl-result home">
                    @item.AwayValue
                </td>
            </tr>
        }
        else
        {
            <tr class="data">
                <td class="cl-match">@item.TimeRange[i]</td>
                <td class="cl-result home" colspan="2">@item.SituationValue[i]</td>
            </tr>
        }

    }
}
