@{
    var viewModel = (Fanex.Result.Core.Models.RazorBinderModel)Model;

    var lang = (Fanex.Result.Core.DataDomain.LangResources)viewModel.Resource;
    const int colspan = 5;
}
@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs">
         <thead>
        @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.OutRightViewModel)viewModel.Data[0];
            <tr class="row-title">
                <th class="cl-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="header">
            <th class="cl-time">
                @lang.Time
            </th>
            <th class="cl-team">
                @lang.Team
            </th>
            <th class="cl-result">
                @lang.Result
            </th>
        </tr>
    </thead>
        </table>
        </div>
}
@if (viewModel.VisibleFreeHeader)
{
    @Raw("<div class=\"fn-rs-content-scroll\">")

}
<table class="fn-rs">
     @if (!viewModel.VisibleFreeHeader)
     {
    <thead>
        @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.OutRightViewModel)viewModel.Data[0];
            <tr class="row-title">
                <th class="cl-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="header">
            <th class="cl-time">
                @lang.Time
            </th>
            <th class="cl-team">
                @lang.Team
            </th>
            <th class="cl-result">
                @lang.Result
            </th>
        </tr>
    </thead>
     }
    <tbody>
        <!--RowData-->
        @if (viewModel.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in viewModel.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.OutRightViewModel)itemObj;
                index++;
                if (!viewModel.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;
            <!--League-->
            <tr class="data">
                <td colspan="3" class="cl-league">
                    @item.LeagueName
                </td>
            </tr>
            <!--/League-->
                    }
                }
            <!--Row-->
            <tr class="data @item.Color(index, "even", "odd")">
                <td class="cl-ko-time">
                    @Raw(item.KickOffTime)
                </td>
                <td class="cl-team">
                    @item.Team
                </td>
                <td class="cl-result">
                    @item.EventStatus
                </td>
            </tr>
            <!--/Row-->
            <!--/RowData-->
            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="3">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}