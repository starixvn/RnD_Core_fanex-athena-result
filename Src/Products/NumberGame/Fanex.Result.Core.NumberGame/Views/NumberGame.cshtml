@{
    var viewModel = (Fanex.Result.Core.Base.ViewModels.RazorBinderModel)Model;

    var colspan = viewModel.VisibleMatchCodeIDColumn ? 8 : 7;
    var popupCss = viewModel.IsPopUp ? "popup" : string.Empty;

}
@using Fanex.Result.Core.NumberGame.ViewModels;
@using Fanex.Result.Core.Base.ViewModels;
@using System.Collections;
@using Fanex.Result.Core.Base.Resources;
@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs number-game @popupCss">
            <thead>
                @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
                {
                    var item = ((GroupData)viewModel.Data[0]).Data[0];

                    <tr class="row-title">
                        <th class="cl-title" colspan="@colspan">
                            <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                        </th>
                    </tr>
                }
                    <tr class="header">
                        @if (viewModel.VisibleMatchCodeIDColumn)
                        {
                            <th class="cl-m-code">
                                @LangResource.MatchCode/@LangResource.ID
                            </th>
                        }
                        <th class="cl-ko-time">
                            @LangResource.KickOffTime
                        </th>
                        <th class="cl-match">
                            @Raw(LangResource.Match)
                        </th>
                        <th class="cl-lblOEFT">
                            @Raw(LangResource.LblFTOE)
                        </th>
                        <th class="cl-lbl1stball">
                            @Raw(LangResource.Lbl1stBall)
                        </th>
                        <th class="cl-lbl2ndball">
                            @Raw(LangResource.Lbl2ndBall)
                        </th>
                        <th class="cl-lastball">
                            @LangResource.LblThirdBall
                        </th>
                        <th class="cl-status">
                            @LangResource.Status
                        </th>
                    </tr>
            </thead>
        </table>
    </div>
}
@if (viewModel.VisibleFreeHeader)
{
    @Raw("<div class=\"fn-rs-content-scroll\">")

}
<table class="fn-rs  number-game @popupCss">
    @if (!viewModel.VisibleFreeHeader)
    {
        <thead>
            @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
            {
                var item = ((GroupData)viewModel.Data[0]).Data[0];

                <tr class="row-title">
                    <th class="cl-title" colspan="@colspan">
                        <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                    </th>
                </tr>
            }
                <tr class="header">
                    @if (viewModel.VisibleMatchCodeIDColumn)
                    {
                        <th class="cl-m-code">
                            @LangResource.MatchCode/@LangResource.ID
                        </th>
                    }
                    <th class="cl-ko-time">
                        @LangResource.KickOffTime
                    </th>
                    <th class="cl-match">
                        @Raw(LangResource.Match)
                    </th>

                    <th class="cl-lblOEFT">
                        @Raw(LangResource.LblFTOE)
                    </th>
                    <th class="cl-lbl1stball">
                        @Raw(LangResource.Lbl1stBall)
                    </th>
                    <th class="cl-lbl2ndball">
                        @Raw(LangResource.Lbl2ndBall)
                    </th>
                    <th class="cl-lastball">
                        @LangResource.LblThirdBall
                    </th>
                    <th class="cl-status">
                        @LangResource.Status
                    </th>
                </tr>
        </thead>
    }
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var index = 0;
            foreach (var itemObj in viewModel.Data)
            {
                var group = (GroupData)itemObj;

                if (!viewModel.IsPopUp)
                {
                    <tr class="data">
                        <td colspan="@colspan" class="cl-league">
                            @group.Data[0].LeagueName
                        </td>
                    </tr>
                }
                foreach (var temp in group.Data)
                {
                    var item = (NumberGameViewModel)temp;
                    index++;

                    <tr class="data @item.Color(index, "even", "odd")">
                        @if (viewModel.VisibleMatchCodeIDColumn)
                        {
                            <td class="cl-m-code">
                                <div class="m-code">
                                    @item.MatchCode
                                </div>
                                <div class="m-id">
                                    @item.MatchId
                                </div>
                            </td>
                        }
                        <td class="cl-ko-time">
                            @Raw(item.KickOffTime)
                        </td>
                        <td class="cl-match">
                            @LangResource.NumberGameNo&nbsp;@item.GameNo
                        </td>

                        <td class="cl-lblOEFT">
                            @item.OEFT
                        </td>
                        <td class="cl-lbl1stball">
                            <span class="lottoBall @NumberGameViewModel.GetBallColor(item.FirstBall)">@item.FirstBall</span>
                        </td>
                        <td class="cl-lbl2ndball">
                            <span class="lottoBall @NumberGameViewModel.GetBallColor(item.SecondBall)">@item.SecondBall</span>
                        </td>
                        <td class="cl-lastball">
                            <span class="lottoBall @NumberGameViewModel.GetBallColor(item.ThirdBall)">@item.ThirdBall</span>
                        </td>
                        <td class="cl-status @item.EventStatusBackground">
                            @item.EventStatus
                        </td>
                    </tr>

                }
            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @LangResource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}