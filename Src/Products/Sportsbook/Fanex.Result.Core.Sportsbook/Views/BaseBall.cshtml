@using Fanex.Result.Core.Base.ViewModels;
@using Fanex.Result.Core.Sportsbook.ViewModels;
@using Fanex.Result.Core.Base.Resources;
@using Fanex.Result.Core.Sportsbook.Resources;
@{
    var viewModel = (RazorBinderModel)Model;
    var firstMatch = viewModel.Data.Count > 0 ? (BaseBallViewModel)viewModel.Data[0].Data[0] : null;
    var colspan = viewModel.VisibleMatchCodeIDColumn ? 1 : 0;
    colspan += firstMatch.IsSeriesMatch ? 11: 15;
    var popupCss = viewModel.IsPopUp ? "popup" : string.Empty;    
    
    
}

@helper RenderHeader(RazorBinderModel viewModel, BaseBallViewModel item, int colspan)
{
    <thead>
    @if(viewModel.Data.Count > 0)
    {
        if (viewModel.VisiblePopUpTitle)
        {
            <tr class="row-title">
                <th class="cl-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }

        if(item.IsSeriesMatch)
        {
            <tr class="header">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <th class="cl-m-code">@LangResource.MatchCode/@LangResource.ID</th>
                }
                <th class="cl-ko-time">@LangResource.KickOffTime</th>
                <th class="cl-match home">@Raw(SportsbookResx.SeriesMatch)</th>
                <th class="cl-ht-score">@LangResource.BaseballGame01</th>
                <th class="cl-ht-score">@LangResource.BaseballGame02</th>
                <th class="cl-ht-score">@LangResource.BaseballGame03</th>
                <th class="cl-ht-score">@LangResource.BaseballGame04</th>
                <th class="cl-ht-score">@LangResource.BaseballGame05</th>
                <th class="cl-ht-score">@LangResource.BaseballGame06</th>
                <th class="cl-ht-score">@LangResource.BaseballGame07</th>
                <th class="cl-f-score">@LangResource.BaseballTotalGames</th>
                <th class="cl-status">@LangResource.Status</th>
            </tr>
        }
        else
        {
            <tr class="header">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <th class="cl-m-code">@LangResource.MatchCode/@LangResource.ID</th>
                }
                <th class="cl-ko-time">@LangResource.KickOffTime</th>
                <th class="cl-match home">@Raw(LangResource.Match)</th>
                @for (var s = 1; s <= 9; s++)
                {
                    <th class="cl-s">@s</th>
                }
                <th class="cl-ei">@LangResource.EI</th>
                <th class="cl-f-score">@SportsbookResx.Runs</th>
                <th class="cl-ht-score">@Raw(SportsbookResx.Hits)</th>
                <th class="cl-status">@LangResource.Status</th>
            </tr>
        }
    }
    </thead>
}

@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs baseball @popupCss">
            @RenderHeader(viewModel, firstMatch, colspan)
        </table>
    </div>

    @Raw("<div class=\"fn-rs-content-scroll\">")
}

<table class="fn-rs baseball @popupCss">
    @if (!viewModel.VisibleFreeHeader)
    {
        @RenderHeader(viewModel, firstMatch, colspan)
    }
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var index = 0;
            foreach (var group in viewModel.Data)
            {
                if (!viewModel.IsPopUp)
                {
                    <tr class="data">
                        <td colspan="@colspan" class="cl-league">@group.Data[0].LeagueName</td>
                    </tr>
                }                
                foreach (BaseBallViewModel item in group.Data)
                {
                    index++;
                    if(item.IsSeriesMatch)
                    {
                        <tr class="data @item.Color(index, "even", "odd")">
                            @if (viewModel.VisibleMatchCodeIDColumn)
                            {
                                <td class="cl-m-code">
                                    <div class="m-code">@item.MatchCode</div>
                                </td>
                            }
                            <td class="cl-ko-time" rowspan="2">@Raw(item.KickOffTime)</td>
                            <td class="cl-match home @item.HomeWin">@Raw(item.HomeTeam)</td>
                            @for (var s = 1; s <= 7; s++)
                            {
                                <td class="cl-ht-score">@item.GetHomeAwaySet(s, true)</td>
                            }
                            
                            <td class="cl-f-score">@item.FinalHomeScore</td>                            
                            <td rowspan="2" class="cl-status @item.EventStatusBackground">
                                @item.EventStatus                                
                            </td>
                        </tr>
                        <tr class="data @item.Color(index, "even", "odd")">
                            @if (viewModel.VisibleMatchCodeIDColumn)
                            {
                                <td class="cl-m-code">@item.MatchId</td>
                            }
                            <td class="cl-match away @item.AwayWin">@Raw(item.AwayTeam)</td>
                            @for (var s = 1; s <= 7; s++)
                            {
                                <td class="cl-ht-score">@item.GetHomeAwaySet(s, false)</td>
                            }                            
                            <td class="cl-f-score">@item.FinalAwayScore</td>                   
                        </tr> 
                    }
                    else
                    {
                        <tr class="data @item.Color(index, "even", "odd")">
                            @if (viewModel.VisibleMatchCodeIDColumn)
                            {
                                <td class="cl-m-code">
                                    <div class="m-code">@item.MatchCode</div>
                                </td>
                            }
                            <td class="cl-ko-time" rowspan="2">@Raw(item.KickOffTime)</td>
                            <td class="cl-match home @item.HomeWin">@Raw(item.HomeTeam)</td>
                            @for (var s = 1; s <= 9; s++)
                            {
                                <td class="cl-s">@item.GetHomeAwaySet(s, true)</td>
                            }
                            <td class="cl-ei">@item.HomeExtraTime</td>
                            <td class="cl-f-score">@item.FinalHomeScore</td>
                            <td class="cl-ht-score">@item.HomeHits</td>                        
                            <td rowspan="2" class="cl-status @item.EventStatusBackground">
                                @item.EventStatus
                                @if (item.VisibleDetailedLink && !viewModel.IsPopUp)
                                {
                                    <div>
                                        <span class="detail-link" data-match-id="@item.MatchId" data-league-id="@item.LeagueId">
                                            @LangResource.Details
                                        </span>
                                    </div>
                                }
                            </td>
                        </tr>
                        <tr class="data @item.Color(index, "even", "odd")">
                            @if (viewModel.VisibleMatchCodeIDColumn)
                            {
                                <td class="cl-m-code">@item.MatchId</td>
                            }
                            <td class="cl-match away @item.AwayWin">@Raw(item.AwayTeam)</td>
                            @for (var s = 1; s <= 9; s++)
                            {
                                <td class="cl-s">@item.GetHomeAwaySet(s, false)</td>
                            }
                            <td class="cl-ei">@item.AwayExtraTime</td>
                            <td class="cl-f-score">@item.FinalAwayScore</td>
                            <td class="cl-ht-score">@item.AwayHits</td>                        
                        </tr>   
                    }
                }
            }
        }
        else
        {
            <!--NoInfo-->
        <tr class="row-noinfo">
            <td colspan="@colspan">@LangResource.NoInfo</td>
        </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}

<!--Detail-->

@if (viewModel.VisibleDetailResult)
{
    <br />

    if (viewModel.Data.Count > 0 && viewModel.Data[0].Data.Count > 0)
    {
        BaseBallViewModel item = (BaseBallViewModel)viewModel.Data[0].Data[0];
        <table class="fn-rs popup">
            <thead>
                <tr class="header">
                    <th class="width-40">@LangResource.MoreResults</th>
                    <th class="width-30">@item.HomeTeam</th>
                    <th class="width-30">@item.AwayTeam</th>
                </tr>
            </thead>
            <tbody>

                @if (item.MoreResultDetail.Count > 0)
                {
                    foreach (var mapResult in item.MoreResultDetail)
                    {                        
                        <tr class="data">
                            <td class="cl-match">@mapResult.ResourceName</td>

                            @if (mapResult.IsDisplaySingleTeam)
                            {
                                <td colspan="2" class="single-result color-blue">@mapResult.HomeValue</td>
                            }
                            else
                            {
                                <td class="cl-result home">@mapResult.HomeValue</td>
                                <td class="cl-result away">@mapResult.AwayValue</td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr class="row-noinfo">
                        <td colspan="3">@LangResource.NoInfo</td>
                    </tr>
                }

            </tbody>
        </table>
    }
}
<!--/Detail-->