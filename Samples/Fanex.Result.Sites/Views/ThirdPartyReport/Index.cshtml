@{
    ViewBag.Title = "Fanex.Result.Core - Third party report.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var custId = "1000";
}
<div style="width: 1000px">
    <form role="form" action="/" class="form-inline filter-form bet-setting">
        <label for="Language">Language</label>
        <select id="language" class="width-100">
            <option value="en-US">en-US</option>
            <option value="ko-KR">ko-KR</option>
            <option value="zh-TW">zh-TW</option>
            <option value="zh-CN">zh-CN</option>
        </select>
    </form>

    <table class="fn-rs">
        <tr class="header">
            <th style="width: 200px; text-align: center">Cust Id</th>
            <th style="width: 200px; text-align: center">Game Id</th>
            <th>Detail link</th>
        </tr>
        <tr class="data-header">
            <th class="cl-league" colspan="3">Voidbridge</th>
        </tr>
        @for (var gamePlayId = 1000; gamePlayId < 1002; gamePlayId++)
        {
            <tr class="data">
                <td>@custId</td>
                <td>@gamePlayId</td>
                <td><button onClick="showVoidbridgeResult('@custId', '@gamePlayId')">Detail</button></td>
            </tr>
        }
        <tr class="data-header">
            <th class="cl-league" colspan="3">Global Gaming</th>
        </tr>
        @for (var gameId = 1010; gameId < 1012; gameId++)
        {
            <tr class="data">
                <td>@custId</td>
                <td>@gameId</td>
                <td><button onClick="showGlobalGamingResult('@custId', '@gameId')">Detail</button></td>
            </tr>
        }

        <tr class="data-header">
            <th class="cl-league" colspan="3">PP</th>
        </tr>
        @for (var gameId = 1010; gameId < 1012; gameId++)
        {
            <tr class="data">
                <td>@custId</td>
                <td>@gameId</td>
                <td><button onClick="showPPResult('@custId', '@gameId')">Detail</button></td>
            </tr>

    
        }

        <tr class="data-header">
            <th class="cl-league" colspan="3">Card Club</th>
        </tr>
        <tr class="data">
            <td>19997145</td>
            <td>1403</td>
            <td><button onClick="showCardClubResult('19997145', '1403')">Detail</button></td>
        </tr>

        <tr class="data-header">
            <th class="cl-league" colspan="3">Spadegaming</th>
        </tr>
        <tr class="data">
            <td>2324354545</td>
            <td>1403</td>
            <td><button onClick="showSpadegamingResult('2324354545', '1403')">Detail</button></td>
        </tr>
    </table>
</div>
<script src="~/Scripts/Page/voidbridge-result.js"></script>
<script>
    var rootUrl = '@Url.Content("~/ThirdPartyReport/")';
    var showVoidbridgeResult = function (custId, gamePlayId) {
        $.get(rootUrl + 'VoidbridgeResult?custid=' + custId + '&gamePlayId=' + gamePlayId + '&language=' + $('#language').val(), function (result) {
            openVoidbridgeResult(result);
        });
    }

    var showGlobalGamingResult = function (custId, gameId) {
        $.get(rootUrl + 'GlobalGamingResult?custid=' + custId + '&gameId=' + gameId + '&language=' + $('#language').val(), function (result) {
            openResultPopUp(JSON.parse(result), "Error in showing Global Gaming Result");
        });
    }

    var showPPResult = function (custId, gamePlayId) {
        $.get(rootUrl + 'PPResult?custid=' + custId + '&gamePlayId=' + gamePlayId + '&language=' + $('#language').val(), function (result) {
            openVoidbridgeResult(result);
        });
    }

    var showSpadegamingResult = function (custId, gamePlayId) {
        $.get(rootUrl + 'SpadegamingResult?custid=' + custId + '&gamePlayId=' + gamePlayId + '&language=' + $('#language').val(), function (result) {
            openVoidbridgeResult(result);
        });
    }

    var showCardClubResult = function (custId, gameTypeId) {
        $.get(rootUrl
            + 'CardClubResult?custid=' + custId
            + '&gameTypeId=' + gameTypeId
            + '&language=' + $('#language').val()
            + '&transId3rd=1224',
            function (result) {
            openVoidbridgeResult(result);
        });
    }

    var openResultPopUp = function (result, failedMessage) {
        'use strict';
        if (result.Error == 0 && result.Url !== '') {
            window.open(result.Url,
                '_blank',
                'left=50,top=50,width=950,height=650' +
                'toolbar=1,resizable=1,scrollbars,status=1');
        } else {
            alert(failedMessage + '\n' + result.Url);
        }
    }
</script>