@{
    var viewModel = (Fanex.Result.Core.Base.ViewModels.RazorBinderModel)Model;

}
@using Fanex.Result.Core.Base.ViewModels;
@using Fanex.Result.Core.LeapGaming.ViewModels;
@using Fanex.Result.Core.Base.Resources;

<table class="fn-rs popup">
    <thead>
        <tr class="header">
            <th class="cl-match">
                @LangResource.Match
            </th>
            <th class="cl-ht-score">
                @LangResource.HTScore
            </th>
            <th class="cl-f-score">
                @LangResource.FinalScore
            </th>
        </tr>
    </thead>
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            foreach (var itemObj in viewModel.Data)
            {
                var group = (GroupData)itemObj;
                var index = 0;
                foreach (var temp in group.Data)
                {
                    var item = (LeapGamingViewModel)temp;
                    foreach (var detail in item.Details)
                    {
                        index++;
                        <tr class="data @item.Color(index, "even", "odd")">
                            <td class="cl-match home">
                                @detail.HomeTeam
                            </td>
                            <td class="cl-ht-score">
                                @detail.HomeHTScore
                            </td>
                            <td class="cl-f-score">
                                @detail.HomeFinalScore
                            </td>
                        </tr>
                        <tr class="data @item.Color(index, "even", "odd")">
                            <td class="cl-match away">
                                @detail.AwayTeam
                            </td>
                            <td class="cl-ht-score">
                                @detail.AwayHTScore
                            </td>
                            <td class="cl-f-score">
                                @detail.AwayFinalScore
                            </td>
                        </tr>
                    }

                }
            }
        }
        else
        {
            <tr class="row-noinfo">
                <td colspan="3">
                    @LangResource.NoInfo
                </td>
            </tr>
        }
    </tbody>
</table>