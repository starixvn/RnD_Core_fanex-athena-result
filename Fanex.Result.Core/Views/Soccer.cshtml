@{
    var viewModel = (Fanex.Result.Core.Models.RazorBinderModel)Model;

    var lang = (Fanex.Result.Core.DTO.LangResources)viewModel.Resource;
    var colspan = viewModel.VisibleMatchCodeIDColumn ? 6 : 5;
}
<table class="fanex-result">
    <colgroup>
        @if (viewModel.VisibleMatchCodeIDColumn)
        {
            <col class="column-matchcode" />

        }
        <col class="column-kickofftime" />
        <col class="column-match" />
        <col class="column-firsthaftscore" />
        <col class="column-finalscore" />
        <col class="column-status" />
    </colgroup>
    <thead>
        @if (viewModel.IsShowPopUpTitle && viewModel.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.SoccerViewModel)viewModel.Data[0];
            <tr class="row-title">
                <th class="column-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="row-header">
            @if (viewModel.VisibleMatchCodeIDColumn)
            {
                <th class="column-matchcode">
                    @lang.MatchCode/@lang.ID
                </th>
            }
            <th class="column-kickofftime">
                @lang.KickOffTime
            </th>
            <th class="column-match">
                @Raw(lang.Match)
            </th>
            <th class="column-firsthaftscore">
                @Raw(lang.FirstHalfScore)
            </th>
            <th class="column-finalscore">
                @lang.FinalScore
            </th>
            <th class="column-status">
                @lang.Status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in viewModel.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.SoccerViewModel)itemObj;
                index++;
                if (!viewModel.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;

            <tr class="row-data">
                <td colspan="@colspan" class="column-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <td class="column-matchcode">
                        <div class="m-code">
                            @item.MatchCode
                        </div>
                    </td>
                }
                <td class="column-kickofftime" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="column-match">
                    @Raw(item.HomeTeam) &nbsp;
                    @if (item.IsShowFGHome)
                    {
                        <div class="first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowLGHome)
                    {
                        <div class="last-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfFGHome)
                    {
                        <div class="first-half-first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfLGHome)
                    {
                        <div class="first-half-last-goal">
                            &nbsp;</div>
                    }
                </td>
                <td class="column-ht-homescore">
                    @item.HTHomeScore
                </td>
                <td class="column-final-homescore">
                    @item.FinalHomeScore
                </td>
                <td rowspan="2" class="column-eventstatus">
                    @item.EventStatus
                    @if (item.VisibleDetailedLink)
                    {
                        <br />
                        <span class="detail-link soccer-detail-link" data-league-id="@item.LeagueId"
                                         data-home-id="@item.HomeId" data-away-id="@item.AwayId" data-goal-record="@item.GoalRecord">
                            [i] </span>
                    }
                    @if (!string.IsNullOrEmpty(item.PenaltyShootoutResult))
                    {
                         <br />
                        <span class="detail-link penalty-result" original-title="@item.PenaltyShootoutTooltip">[PS:@item.PenaltyShootoutResult]
                        </span>
                    }
                </td>
            </tr>
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <td class="column-matchcode">
                        @item.MatchId
                    </td>
                }
                <td class="column-match">
                    @Raw(item.AwayTeam) &nbsp;
                    @if (item.IsShowFGAway)
                    {
                        <div class="first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowLGAway)
                    {
                        <div class="last-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfFGAway)
                    {
                        <div class="first-half-first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfLGAway)
                    {
                        <div class="first-half-last-goal">
                            &nbsp;</div>
                    }
                </td>
                <td class="column-ht-awayscore">
                    @item.HTAwayScore
                </td>
                <td class="column-ht-finalscore">
                    @item.FinalAwayScore
                </td>
            </tr>

            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>