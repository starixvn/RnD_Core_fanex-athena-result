@{
    var viewModel = (Fanex.Result.Core.Base.ViewModels.RazorBinderModel)Model;

    var lang = (Fanex.Result.Core.Base.DataDomain.LangResources)viewModel.Resource;
    var colspan = 2;
    var popupCss = viewModel.IsPopUp || viewModel.IsDetail ? "popup" : string.Empty;
    
}
@using Fanex.Result.Core.Base.ViewModels;
@using Fanex.Result.Core.MetricGaming.ViewModels;
@using System.Collections;
<table class="fn-rs metric-gaming @popupCss">
    <thead>
        @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
        {
            var item = ((GroupData)viewModel.Data[0]).Data[0];

            <tr class="row-title">
                <th class="cl-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
    </thead>
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            foreach (var itemObj in viewModel.Data)
            {
                var group = (GroupData)itemObj;

                foreach (var temp in group.Data)
                {
                    var item = (SoccerViewModel)temp;
            <tr class="header">
                <td colspan="@colspan" class="cl-match">
                    @item.HomeTeam&nbsp;-&nbsp;@lang.VS&nbsp;@item.AwatTeam
                </td>
            </tr>
            <tr class="data data-header">
                <td class="cl-event">
                    @lang.Event
                </td>
                <td class="cl-result">
                    @lang.Result
                </td>
            </tr>
                    if (item.IsShowNoInfoRow)
                    {
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>   
                    }
                    else
                    {
            <tr class="data">
                <td class="cl-event" rowspan="@item.EventResult.Count">
                    @Raw(item.EventName)
                </td>
                <td class="cl-result">
                    @Raw(item.EventResult[0])
                </td>
            </tr>
                        if (item.EventResult.Count > 1)
                        {
                            for (var i = 1; i < item.EventResult.Count; i++)
                            {
            <tr class="data">
                <td class="cl-result">
                    @Raw(item.EventResult[i])
                </td>
            </tr>
                            }
                        }
                    }

                }
            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
