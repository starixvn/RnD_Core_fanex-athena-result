@{
    var viewModel = (Fanex.Result.Core.Models.RazorBinderModel)Model;

    var lang = (Fanex.Result.Core.DTO.LangResources)viewModel.Resource;
    var colspan = viewModel.IsShowMatchCodeAndId ? 9 : 8;
}
<table class="fanex-result">
    <colgroup>
        @if (viewModel.IsShowMatchCodeAndId)
        {
            <col class="column-matchcode" />

        }
        <col class="column-kickofftime" />
        <col class="column-match" />
        <col class="column-result" />
        <col class="column-warrior" />
        <col class="column-lblOEFT" />
        <col class="column-lbl1stball" />
        <col class="column-lastball" />
        <col class="column-status" />
    </colgroup>
    <thead>
        @if (viewModel.IsShowPopUpTitle && viewModel.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.NumberGameViewModel)viewModel.Data[0];
            <tr class="row-title">
                <th class="column-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="row-header">
            @if (viewModel.IsShowMatchCodeAndId)
            {
                <th class="column-matchcode">
                    @lang.MatchCode/@lang.ID
                </th>
            }
            <th class="column-kickofftime">
                @lang.KickOffTime
            </th>
            <th class="column-match">
                @Raw(lang.Match)
            </th>
            <th class="column-result">
                @Raw(lang.Result)
            </th>
            <th class="column-warrior">
                @Raw(lang.Warrior)
            </th>
            <th class="column-lblOEFT">
                @Raw(lang.LblOEFT)
            </th>
            <th class="column-lbl1stball">
                @Raw(lang.Lbl1stBall)
            </th>
            <th class="column-lastball">
                @lang.LastBall
            </th>
            <th class="column-status">
                @lang.Status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in viewModel.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.NumberGameViewModel)itemObj;
                index++;
                if (!viewModel.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;

            <tr class="row-data">
                <td colspan="@colspan" class="column-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }

            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                @if (viewModel.IsShowMatchCodeAndId)
                {
                    <td class="column-matchcode">
                        <div class="m-code">
                            @item.MatchCode
                        </div>
                        <div class="m-id">
                            @item.MatchId
                        </div>
                    </td>
                }
                <td class="column-kickofftime">
                    @Raw(item.KickOffTime)
                </td>
                <td class="column-match">
                    @lang.NumberGameNo&nbsp;@item.GameNo
                </td>
                <td class="column-result">
                    @foreach (var ball in item.Result)
                    {
                        <span class="ball">@ball</span>
                    }
                </td>
                <td class="column-warrior">
                    @item.Warrior
                </td>
                <td class="column-lblOEFT">
                    @item.OEFT
                </td>
                <td class="column-lbl1stball">
                    <span class="ball">@item.FirstBall</span>
                </td>
                <td class="column-lastball">
                    <span class="ball">@item.LastBall</span>
                </td>
                <td class="column-eventstatus">
                    @item.EventStatus
                </td>
            </tr>

            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>