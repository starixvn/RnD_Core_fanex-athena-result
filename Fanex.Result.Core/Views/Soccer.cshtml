@{
    var viewModel = (Fanex.Result.Core.Models.RazorBinderModel)Model;

    var lang = (Fanex.Result.Core.DataDomain.LangResources)viewModel.Resource;
    var colspan = viewModel.VisibleMatchCodeIDColumn ? 6 : 5;
    var popupCss = viewModel.IsPopUp || viewModel.IsDetail ? "popup" : string.Empty;
    
}
@using Fanex.Result.Core.ViewModels;
@using Fanex.Result.Core.Models;
@using System.Collections;
@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs @popupCss">
            <thead>
                @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
                {
                    var item = ((GroupData)viewModel.Data[0]).Data[0];
                    <tr class="row-title">
                        <th class="cl-title" colspan="@colspan">
                            <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                        </th>
                    </tr>
                }
                <tr class="header">
                    @if (viewModel.VisibleMatchCodeIDColumn)
                    {
                        <th class="cl-m-code">
                            @lang.MatchCode/@lang.ID
                        </th>
                    }
                    <th class="cl-ko-time">
                        @lang.KickOffTime
                    </th>
                    <th class="cl-match">
                        @Raw(lang.Match)
                    </th>
                    <th class="cl-ht-score">
                        @Raw(lang.HTScore)
                    </th>
                    <th class="cl-f-score">
                        @lang.FinalScore
                    </th>
                    <th class="cl-status">
                        @lang.Status
                    </th>
                </tr>
            </thead>
        </table>
    </div>
}
@if (viewModel.VisibleFreeHeader)
{
    @Raw("<div class=\"fn-rs-content-scroll\">")

}
<table class="fn-rs @popupCss">
    @if (!viewModel.VisibleFreeHeader)
    {
        <thead>
            @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
            {
                var item = ((GroupData)viewModel.Data[0]).Data[0];
                <tr class="row-title">
                    <th class="cl-title" colspan="@colspan">
                        <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                    </th>
                </tr>
            }
            <tr class="header">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <th class="cl-m-code">
                        @lang.MatchCode/@lang.ID
                    </th>
                }
                <th class="cl-ko-time">
                    @lang.KickOffTime
                </th>
                <th class="cl-match">
                    @Raw(lang.Match)
                </th>
                <th class="cl-ht-score">
                    @Raw(lang.HTScore)
                </th>
                <th class="cl-f-score">
                    @lang.FinalScore
                </th>
                <th class="cl-status">
                    @lang.Status
                </th>
            </tr>
        </thead>
    }
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var index = 0;
            foreach (var itemObj in viewModel.Data)
            {
                var group = (GroupData)itemObj;

                if (!viewModel.IsPopUp)
                {

            <tr class="data">
                <td colspan="@colspan" class="cl-league">
                    @group.Data[0].LeagueName
                </td>
            </tr>

                }
                foreach (var temp in group.Data)
                {
                    var item = (SoccerViewModel)temp;
                    index++;
            <tr class="data @item.Color(index, "even", "odd")">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <td class="cl-m-code">
                        <div class="m-code">
                            @item.MatchCode
                        </div>
                    </td>
                }
                <td class="cl-ko-time" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="cl-match home @item.HomeWin">
                    @Raw(item.HomeTeam) &nbsp;
                    @if (item.IsShowFGHome)
                    {
                        <div class="first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowLGHome)
                    {
                        <div class="last-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfFGHome)
                    {
                        <div class="first-half-first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfLGHome)
                    {
                        <div class="first-half-last-goal">
                            &nbsp;</div>
                    }
                </td>
                <td class="cl-ht-score">
                    @item.HTHomeScore
                </td>
                <td class="cl-f-score">
                    @item.FinalHomeScore
                </td>
                <td rowspan="2" class="cl-status @item.EventStatusBackground">
                    <div>
                        @item.EventStatus
                    </div>
                    @if (item.VisibleDetailedLink && !viewModel.IsPopUp)
                    {
                        <div>
                            <span class="detail-link" data-match-id="@item.MatchId" data-league-id="@item.LeagueId" data-home-id="@item.HomeId" data-away-id="@item.AwayId">
                                @lang.Details </span>
                        </div>
                    }
                </td>
            </tr>
            <tr class="data @item.Color(index, "even", "odd")">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <td class="cl-m-code">
                        @item.MatchId
                    </td>
                }
                <td class="cl-match away @item.AwayWin">
                    @Raw(item.AwayTeam) &nbsp;
                    @if (item.IsShowFGAway)
                    {
                        <div class="first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowLGAway)
                    {
                        <div class="last-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfFGAway)
                    {
                        <div class="first-half-first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfLGAway)
                    {
                        <div class="first-half-last-goal">
                            &nbsp;</div>
                    }
                </td>
                <td class="cl-ht-score">
                    @item.HTAwayScore
                </td>
                <td class="cl-f-score">
                    @item.FinalAwayScore
                </td>
            </tr>

                }
            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}
@if (viewModel.VisibleDetailResult)
{
    var mainItem = ((GroupData)viewModel.Data[0]).Data[0] as SoccerViewModel;
    var gameResult = mainItem.DetailedResult;
    if (mainItem.VisisibleGoalRecord)
    {
        var homeScore = 0;
        var awayScore = 0;
    
    <div class="goal-record">
    <table>
        <thead>
            <tr class="header">
                <th class="cl-goal" colspan="2">
                    @lang.GoalRecord
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var goal in mainItem.GoalRecord)
            {
                homeScore += 'h' == char.ToLower(goal) ? 1 : 0;
                awayScore += 'a' == char.ToLower(goal) ? 1 : 0;
                <tr class="data">
                    <td class="cl-goal">
                        @homeScore - @awayScore
                    </td>
                    <td class="cl-goal">
                        @(Equals('h', char.ToLower(goal)) ? lang.Home : lang.Away)
                    </td>
                </tr>
            }
        </tbody>
    </table>
      </div>
    }
    if (!string.IsNullOrEmpty(gameResult))
    {
    <br />
    <table class="fn-rs popup">
        <thead>
            <tr class="header">
                <th class="cl-match">
                    @lang.MoreResults
                </th>
                <th class="cl-result home">
                    @mainItem.HomeTeam
                </th>
                <th class="cl-result away">
                    @mainItem.AwayTeam
                </th>
            </tr>
        </thead>
        <tbody>
            @Raw(gameResult)
        </tbody>
    </table> 
    }
}