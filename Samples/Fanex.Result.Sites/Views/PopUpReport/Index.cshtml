    <div class="form-group">
        <label for="league">MatchId</label>
        <input type="text" id="matchid" value="" class="width-100" />
    </div>
    <div class="form-group">
        <label for="betid">BetId</label>
        <input type="text" id="betid" value="" class="width-40" />
    </div>
    <div class="form-group">
        <label for="league">Handicap2</label>
        <input type="text" id="handicap2" value="" class="width-100" />
    </div>
    <div class="form-group">
        <label for="league">RaceNo</label>
        <input type="text" id="raceno" value="" class="width-100" />
    </div>

    <div class="form-group">
        <label for="league">RefNo</label>
        <input id="refno" type="text" value="" class="width-100" />
    </div>

    <div class="form-group">
        <label for="league">TransDesc</label>
        <input id="transdesc" type="text" value="" class="width-100" />
    </div>

    <div class="form-group">
        <label for="league">OutRight</label>
        <input id="isoutright" type="checkbox" />
    </div>
    <div class="form-group">
        <label for="excel-data">Get Data From Excel</label>
        <input type="checkbox" id="get-data-from-excel" />
    </div>
    <div class="form-group">
        <input type="button" id="export-excel-file" value="Export Excel Data File" class="btn btn-primary" />
    </div>
    <div class="form-group">
        <label for="Language">Language</label>
        <select id="language" class="width-100">
            <option value="en-US">en-US</option>
            <option value="ko-KR">ko-KR</option>
            <option value="zh-TW">zh-TW</option>
            <option value="zh-CN">zh-CN</option>
            <option value="zh-Hans">zh-Hans</option>
            <option value="th-TH">th-TH</option>
            <option value="ja-JP">ja-JP</option>
            <option value="vi-VN">vi-VN</option>
        </select>
    </div>
    <div class="form-group">
        <input type="button" id="gen-html" value="Gen Html" class="btn btn-primary" />
    </div>
</form>
<div id="report-content" class="col-sm-8">
</div>
@section FooterJs
{
    <script type="text/javascript">
        $(document).ready(function () {
            popupReport.setup();
        });
    </script>
}