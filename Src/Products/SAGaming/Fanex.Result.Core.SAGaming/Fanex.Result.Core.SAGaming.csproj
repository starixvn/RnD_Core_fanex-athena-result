<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.1;net7.0</TargetFrameworks> 
    <OutputType>Library</OutputType>
    <RestorePackages>true</RestorePackages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Fanex.Result.Core.SAGaming</AssemblyTitle>
    <Product>Fanex.Result.Core.SAGaming</Product>
    <Copyright>Copyright ©  2016</Copyright>
    <Version>2.0.0.0-beta-04</Version>
    <PackageReleaseNotes>Support .net Core for Result Core package (#191539)</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>    
    <PackageReference Include="Fanex.Result.Core-NPOI.2.0.6" Version="3.0.0-beta-10" />    
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>  
  </ItemGroup>
</Project>