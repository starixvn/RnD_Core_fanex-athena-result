@{
    var itemViewModel = (Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerDetailViewModel)Model;

    var lang = (Fanex.Result.Core.Base.DataDomain.LangResources)itemViewModel.Resource;

}
@using Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo;
@using Fanex.Result.Core.Sportsbook.ViewModels;
@using System.Collections;
<tr class="data">
    <td colspan="3" class="cl-league sub">
        @itemViewModel.Name
    </td>
</tr>
<!--Merge row-->
@{
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem homePlayserSentOff1H = null;
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem awayPlayserSentOff1H = null;
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem homePlayserSentOff = null;
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem awayPlayserSentOff = null;
    var firstHalfResource = string.Empty;
    var fullTimeResource = string.Empty;
}
@foreach (var item in itemViewModel.DetailItems)
{
    switch (item.ResourceID)
    {
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.HomePlayserSentOff:
            fullTimeResource = item.ResourceName;
            homePlayserSentOff = item;
            break;
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.AwayPlayserSentOff:
            fullTimeResource = item.ResourceName;
            awayPlayserSentOff = item;
            break;
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.HomePlayserSentOff1H:
            firstHalfResource = item.ResourceName;
            homePlayserSentOff1H = item;
            break;
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.AwayPlayserSentOff1H:
            firstHalfResource = item.ResourceName;
            awayPlayserSentOff1H = item;
            break;
    }
}
<!--Assign "-" value in case it's value is null or empty-->
@if (homePlayserSentOff1H != null || homePlayserSentOff1H != null)
{
    <tr class="data">
        <td class="cl-match">
            @firstHalfResource
        </td>
        <td class="cl-result home">
            @if (homePlayserSentOff1H == null || string.IsNullOrEmpty(homePlayserSentOff1H.HomeValue))
            {
                @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @homePlayserSentOff1H.HomeValue
            }
        </td>
        <td class="cl-result away">
            @if (awayPlayserSentOff1H == null || string.IsNullOrEmpty(awayPlayserSentOff1H.HomeValue))
            {
                 @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @awayPlayserSentOff1H.HomeValue
            }
        </td>
    </tr>
}
@if (homePlayserSentOff != null || awayPlayserSentOff != null)
{
    <tr class="data">
        <td class="cl-match">
            @fullTimeResource
        </td>
        <td class="cl-result home">
            @if (homePlayserSentOff == null || string.IsNullOrEmpty(homePlayserSentOff.HomeValue))
            {
                @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @homePlayserSentOff.HomeValue
            }
        </td>
        <td class="cl-result away">
            @if (awayPlayserSentOff == null || string.IsNullOrEmpty(awayPlayserSentOff.HomeValue))
            {
                @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @awayPlayserSentOff.HomeValue
            }
        </td>
    </tr>
}