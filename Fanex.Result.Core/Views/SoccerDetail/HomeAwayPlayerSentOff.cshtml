@{
    var itemViewModel = (Fanex.Result.Core.ViewModels.SoccerInfo.SoccerDetailViewModel)Model;

    var lang = (Fanex.Result.Core.DataDomain.LangResources)itemViewModel.Resource;

}
@using Fanex.Result.Core.ViewModels;
@using Fanex.Result.Core.Models;
@using System.Collections;
<tr class="data">
    <td colspan="3" class="cl-league sub">
        @itemViewModel.Name
    </td>
</tr>
<!--Merge row-->
@{
    Fanex.Result.Core.ViewModels.SoccerInfo.SoccerGameDetailItem firstHalf = null;
    Fanex.Result.Core.ViewModels.SoccerInfo.SoccerGameDetailItem fullTime = null;

}
@foreach (var item in itemViewModel.DetailItems)
{
    if (item.ResourceName == lang.RS213)
    {
        if (firstHalf == null)
        {
            firstHalf = item;
        }
        if (!string.IsNullOrEmpty(item.HomeValue))
        {
            firstHalf.HomeValue = item.HomeValue;
        }
        if (!string.IsNullOrEmpty(item.AwayValue))
        {
            firstHalf.AwayValue = item.AwayValue;
        }
    }
    else if (item.ResourceName == lang.RS212)
    {
        if (fullTime == null)
        {
            fullTime = item;
        }
        if (!string.IsNullOrEmpty(item.HomeValue))
        {
            fullTime.HomeValue = item.HomeValue;
        }
        if (!string.IsNullOrEmpty(item.AwayValue))
        {
            fullTime.AwayValue = item.AwayValue;
        }
    }

}
<!--Assign "-" value in case it's value is null or empty-->
@if (firstHalf != null)
{
    <tr class="data">
        <td class="cl-match">
            @firstHalf.ResourceName
        </td>
        <td class="cl-result home">
            @if (string.IsNullOrEmpty(firstHalf.HomeValue))
            {
               @Fanex.Result.Core.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @firstHalf.HomeValue
            }
        </td>
        <td class="cl-result away">
           @if (string.IsNullOrEmpty(firstHalf.AwayValue))
           {
               @Fanex.Result.Core.DataDomain.ConstantValue.Hyphen
           }
           else
           {
                @firstHalf.AwayValue
           }
        </td>
    </tr>
}
@if (fullTime != null)
{
    <tr class="data">
        <td class="cl-match">
            @fullTime.ResourceName
        </td>
       <td class="cl-result home">
            @if (string.IsNullOrEmpty(fullTime.HomeValue))
            {
               @Fanex.Result.Core.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @fullTime.HomeValue
            }
        </td>
        <td class="cl-result away">
           @if (string.IsNullOrEmpty(fullTime.AwayValue))
           {
               @Fanex.Result.Core.DataDomain.ConstantValue.Hyphen
           }
           else
           {
                @fullTime.AwayValue
           }
        </td>
    </tr>
}