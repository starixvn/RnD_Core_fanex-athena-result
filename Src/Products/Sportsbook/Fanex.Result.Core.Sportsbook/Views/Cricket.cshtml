@using Fanex.Result.Core.Base.Resources;
@using Fanex.Result.Core.Base.ViewModels;
@using Fanex.Result.Core.Sportsbook.ViewModels;
@{
    var viewModel = (RazorBinderModel)Model;

    var popupCss = viewModel.IsPopUp || viewModel.IsDetail ? "popup" : string.Empty;
    var firstMatch = viewModel.Data.Count > 0 ? (CricketViewModel)viewModel.Data[0].Data[0] : null;
    var colspan = viewModel.VisibleMatchCodeIDColumn ? 7 : 6;
}

@helper RenderHeader(RazorBinderModel viewModel, CricketViewModel firstMatch, int colspan)
{
    <thead>
        @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
        {
            <tr class="row-title">
                <th class="cl-title" colspan="@colspan">
                    <span class="sport">@firstMatch.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@firstMatch.LeagueName</span>
                </th>
            </tr>
        }
            <tr class="header">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <th class="cl-m-code">@LangResource.MatchCode/@LangResource.ID</th>
                }
                <th class="cl-ko-time">@LangResource.KickOffTime</th>
                <th class="cl-match">@LangResource.Match</th>
                <th class="cl-ht-score">@LangResource.Inns1</th>
                <th class="cl-ht-score">@LangResource.Inns2</th>
                <th class="cl-f-score">@LangResource.FinalScore</th>
                <th class="cl-status">@LangResource.Status</th>
            </tr>
    </thead>
}

@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs @popupCss">
            @RenderHeader(viewModel, firstMatch, colspan)
        </table>
    </div>
}

@if (viewModel.VisibleFreeHeader)
{
    @Raw("<div class=\"fn-rs-content-scroll\">")
}
<table class="fn-rs @popupCss">
    @if (!viewModel.VisibleFreeHeader)
    {
        @RenderHeader(viewModel, firstMatch, colspan)
    }
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var index = 0;
            foreach (var group in viewModel.Data)
            {
                if (!viewModel.IsPopUp)
                {
                    <tr class="data">
                        <td colspan="@colspan" class="cl-league">@group.Data[0].LeagueName</td>
                    </tr>
                }

                foreach (CricketViewModel item in group.Data)
                {
                    index++;
                    <tr class="data @item.Color(index, "even", "odd")">
                        @if (viewModel.VisibleMatchCodeIDColumn)
                        {
                            <td class="cl-m-code">
                                <div class="m-code">@item.MatchCode</div>
                            </td>
                        }
                        <td class="cl-ko-time" rowspan="2">@Raw(item.KickOffTime)</td>
                        <td class="cl-match home @item.HomeWin">@item.HomeTeam</td>
                        <td class="cl-ht-score">@item.HomeFirstRuns</td>
                        <td class="cl-ht-score">@item.HomeSecondRuns</td>
                        <td class="cl-f-score">@item.HomeFinalRuns</td>
                        <td rowspan="2" class="cl-status @item.EventStatusBackground">
                            <div>@item.EventStatus</div>
                            @if (item.VisibleDetailedLink && !viewModel.IsPopUp)
                            {
                                <div>
                                    <span class="detail-link" data-match-id="@item.MatchId" data-league-id="@item.LeagueId" data-home-id="@item.HomeId" data-away-id="@item.AwayId">
                                        @LangResource.Details
                                    </span>
                                </div>
                            }
                        </td>
                    </tr>
                    <tr class="data @item.Color(index, "even", "odd")">
                        @if (viewModel.VisibleMatchCodeIDColumn)
                        {
                            <td class="cl-m-code">@item.MatchId</td>
                        }
                        <td class="cl-match away @item.AwayWin">@item.AwayTeam</td>
                        <td class="cl-ht-score">@item.AwayFirstRuns</td>
                        <td class="cl-ht-score">@item.AwaySecondRuns</td>
                        <td class="cl-f-score">@item.AwayFinalRuns</td>
                    </tr>
                }
            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">@LangResource.NoInfo</td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}
@if (viewModel.VisibleDetailResult)
{
    var mainItem = viewModel.Data[0].Data[0] as CricketViewModel;
    var gameResult = mainItem.DetailedResult;
    
    if (!string.IsNullOrEmpty(gameResult))
    {
        <br />
        <table class="fn-rs popup">
            <thead>
                <tr class="header">
                    <th class="cl-match">@LangResource.MoreResults</th>
                    <th class="cl-result home">@mainItem.HomeTeam</th>
                    <th class="cl-result away">@mainItem.AwayTeam</th>
                </tr>
            </thead>
            <tbody>
                @Raw(gameResult)
            </tbody>
        </table>
    }
}

