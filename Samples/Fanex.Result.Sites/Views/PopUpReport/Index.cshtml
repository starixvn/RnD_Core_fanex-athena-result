@{
    ViewBag.Title = "Fanex.Result.Core - Popup report.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Fanex.Result/Allbet/css/table_w.css" rel="stylesheet" />
<link href="~/Content/Fanex.Result/SexyGaming/css/table_w.css" rel="stylesheet" />
@section Headline {
    <ul class="breadcrumb title">
        <li>Demo</li>
        <li class="current">PopUp</li>
    </ul>
}
