@using Fanex.Result.Core.Base.ViewModels;
@using Fanex.Result.Core.Sportsbook.ViewModels;
@using Fanex.Result.Core.Base.Resources;
@using Fanex.Result.Core.Sportsbook.ViewModels.BasketBallDetail;
@using Fanex.Result.Core.Sportsbook.Resources;
@using System.Linq;
@using Fanex.Result.Core.Base.DataDomain;
@{
	var viewModel = (RazorBinderModel)Model;
	var colspan = viewModel.VisibleMatchCodeIDColumn ? 12 : 11;
	var popupCss = viewModel.IsPopUp ? "popup" : string.Empty;
	var mainItem = viewModel.Data.Count > 0 ? (BasketBallViewModel)viewModel.Data[0].Data[0] : null;
	var isShowLiveScore = false;
	foreach (var data in viewModel.Data)
	{
		foreach (BasketBallViewModel item in data.Data)
		{
			if (item.IsShowLiveScore)
			{
				isShowLiveScore = item.IsShowLiveScore;
			}
		}
	}

	colspan += isShowLiveScore ? 1 : 0;

	void RenderHeader(RazorBinderModel viewModel, BasketBallViewModel firstMatch, int colspan, bool isShowLiveScore)
	{
		<thead>
			@if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
			{
				<tr class="row-title">
					<th class="cl-title" colspan="@colspan">
						<span class="sport">@firstMatch.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@firstMatch.LeagueName</span>
					</th>
				</tr>
			}
			<tr class="header">
				@if (viewModel.VisibleMatchCodeIDColumn)
				{
					<th class="cl-m-code">@LangResource.MatchCode/@LangResource.ID</th>
				}
				<th class="cl-ko-time">@LangResource.KickOffTime</th>
				<th class="cl-match">@Raw(LangResource.Match)</th>
				<th class="cl-s">@LangResource.Lbl1Q</th>
				<th class="cl-s">@LangResource.Lbl2Q</th>
				<th class="cl-s">@LangResource.Lbl3Q</th>
				<th class="cl-s">@LangResource.Lbl4Q</th>
				<th class="cl-s">@LangResource.LblOT</th>
				<th class="cl-ht-score">@Raw(LangResource.HTScore)</th>
				<th class="cl-ht-score">@Raw(LangResource._2HScore)</th>
				<th class="cl-f-score">@LangResource.FinalScore</th>
				@if (isShowLiveScore)
				{
					<th class="cl-f-score">@LangResource.LiveScore</th>
				}
				<th class="cl-status">@LangResource.Status</th>
			</tr>
		</thead>
	}
}

@if (viewModel.VisibleFreeHeader)
{
	<div class="fn-rs-content-header">
		<table class="fn-rs @popupCss">
			@{
				RenderHeader(viewModel, mainItem, colspan, isShowLiveScore);
			}
		</table>
	</div>

	@Raw("<div class=\"fn-rs-content-scroll\">")

}
<table class="fn-rs @popupCss">
	@if (!viewModel.VisibleFreeHeader)
	{
		RenderHeader(viewModel, mainItem, colspan, isShowLiveScore);
	}
	<tbody>
		@if (viewModel.Data.Count > 0)
		{
			var index = 0;

			foreach (var group in viewModel.Data)
			{
				if (!viewModel.IsPopUp)
				{
					<tr class="data">
						<td colspan="@colspan" class="cl-league">@group.Data[0].LeagueName</td>
					</tr>
				}
				foreach (BasketBallViewModel item in group.Data)
				{
					index++;
					<tr class="data @item.Color(index, "even", "odd")">
						@if (viewModel.VisibleMatchCodeIDColumn)
						{
							<td class="cl-m-code">
								<div class="m-code">@item.MatchCode</div>
							</td>
						}
						<td class="cl-ko-time" rowspan="2">@Raw(item.KickOffTime)</td>
						<td class="cl-match home @item.HomeWin">@Raw(item.HomeTeam)</td>
						@for (var s = 0; s < 4; s++)
						{
							<td class="cl-s">@item.GetHomeAwaySet(s, true)</td>
						}
						<td class="cl-s">@item.OTHome</td>
						<td class="cl-ht-score">@item.HTHomeScore</td>
						<td class="cl-ht-score">@item.SecondHaftHomeScore</td>
						<td class="cl-f-score">@item.FinalHomeScore</td>
						@if (isShowLiveScore)
						{
							<td class="cl-f-score">@item.LiveHomeScore</td>
						}
						<td rowspan="2" class="cl-status @item.EventStatusBackground">
							@item.EventStatus
							@if (item.VisibleDetailedLink && !viewModel.IsPopUp)
							{
								<div>
									<span class="detail-link" data-match-id="@item.MatchId" data-league-id="@item.LeagueId">
										@LangResource.Details
									</span>
								</div>
							}
						</td>
					</tr>
					<tr class="data @item.Color(index, "even", "odd")">
						@if (viewModel.VisibleMatchCodeIDColumn)
						{
							<td class="cl-m-code">@item.MatchId</td>
						}
						<td class="cl-match away @item.AwayWin">@Raw(item.AwayTeam)</td>
						@for (var s = 0; s < 4; s++)
						{
							<td class="cl-s">@item.GetHomeAwaySet(s, false)</td>
						}
						<td class="cl-s">@item.OTAway</td>
						<td class="cl-ht-score">@item.HTAwayScore</td>
						<td class="cl-ht-score">@item.SecondHaftAwayScore</td>
						<td class="cl-f-score">@item.FinalAwayScore</td>
						@if (isShowLiveScore)
						{
							<td class="cl-f-score">@item.LiveAwayScore</td>
						}
					</tr>
				}
			}
		}
		else
		{
			<!--NoInfo-->
			<tr class="row-noinfo">
				<td colspan="@colspan">@LangResource.NoInfo</td>
			</tr>
			<!--/NoInfo-->
		}
	</tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
	@Raw("</div>")
}

@if (viewModel.VisibleDetailResult && mainItem.MoreResultDetailItems.Any() && mainItem.PlayerProMainResultItem == null)
{
	<br />
	<table class="fn-rs popup">
		<thead>
			<tr class="header">
				<th class="cl-match">@LangResource.BetType</th>
				<th class="cl-result home">@LangResource.Result</th>
			</tr>
		</thead>
		<tbody>
			@foreach (BasketBallGameDetailItem item in mainItem.MoreResultDetailItems)
			{
				<tr>
					<td class="cl-match">@item.ResourceName</td>
					<td class="cl-result @(item.IsHome ? "home" : item.IsAway ? "away": string.Empty)">
						@item.HomeValue
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@if (mainItem.PlayerProMainResultItem != null)
{
	<br />
	<table class="fn-rs popup">
		<thead>
			<tr class="header">
				<th class="cl-match">@LangResource.Player</th>
				@foreach (var item in mainItem.PlayerProHeaderItems)
				{
					<th class="cl-result home">@item</th>
				}
			</tr>
		</thead>
		<tbody>
            @if(mainItem.PlayerProMainResultItem.Players.Players.Count() == 1){
				<tr>
					@{
                        var player = mainItem.PlayerProMainResultItem.Players.Players[0];
					}

                    <td class="cl-match" rowspan="@(mainItem.PlayerProMainResultItem.IsRefundWithSettleDetermined ? 2 : 1)">@player.PlayerName</td>

					@if(mainItem.PlayerProMainResultItem.IsRefundAll)
					{
						<td class="cl-result home" rowspan="@mainItem.PlayerProHeaderItems.Length">@LangResource.Refund</td>
					}
					else
					{
						foreach(var playerResult in player.ResultDetailItems)
						{
							<td class="cl-result home">@playerResult.HomeValue</td>
						}
					}
				</tr>
                if(mainItem.PlayerProMainResultItem.IsRefundWithSettleDetermined)
                {
                    <tr>
                        <td class="cl-result home" colspan="@mainItem.PlayerProHeaderItems.Length">(@LangResource.RefundWithSettleDetermined)</td>
                    </tr>
                }
            }
            else if (mainItem.PlayerProMainResultItem.Players.Players.Count() == 2)
            {
                var player1 = mainItem.PlayerProMainResultItem.Players.Players[0];
                var player2 = mainItem.PlayerProMainResultItem.Players.Players[1];
                
                <tr>
                    <td class="cl-match">@player1.PlayerName</td>
                    @if(mainItem.PlayerProMainResultItem.IsRefundAll)
                    {
                        <td class="cl-result home" colspan="@mainItem.PlayerProHeaderItems.Length" rowspan="2">@LangResource.Refund</td>
                    }
                    else
                    {
                        foreach(var item in player1.ResultDetailItems)
                        {
                            <td class="cl-result home">@(mainItem.PlayerProMainResultItem.HomeValue == LangResource.Refund ? LangResource.Refund : item.HomeValue)</td>
                        }
                    }
                </tr>
                <tr>
                    @if(mainItem.PlayerProMainResultItem.IsRefundWithSettleDetermined)
                    {
                        <td class="cl-match" rowspan="2">@player2.PlayerName</td>
                    }
                    else
                    {
                        <td class="cl-match">@player2.PlayerName</td>
                    }

                    @if(!mainItem.PlayerProMainResultItem.IsRefundAll)
                    {
                        foreach(var item in player2.ResultDetailItems)
                        {
                            <td class="cl-result home">@(mainItem.PlayerProMainResultItem.HomeValue == LangResource.Refund ? LangResource.Refund : item.HomeValue)</td>
                        }
                    }
                </tr>
                if(mainItem.PlayerProMainResultItem.IsRefundWithSettleDetermined)
                {
                    <tr>
                        <td class="cl-result home" colspan="@mainItem.PlayerProHeaderItems.Length">(@LangResource.RefundWithSettleDetermined)</td>
                    </tr>
                }
            }
		</tbody>
	</table>
}

@if (mainItem != null && mainItem.VisibleBetBuilderDetail)
{
	<br />
	<table class="fn-rs popup">
		<thead>
			<tr class="header">
				<th class="cl-match">@SportsbookResx.Selection</th>
				<th class="cl-result home">@LangResource.Status</th>
			</tr>
		</thead>
		<tbody>
			@Raw(mainItem.BetBuilderResult)
		</tbody>
	</table>
}
