@{
    var lang = (Fanex.Result.Core.DTO.LangResources)Model.Resource;
    var colspan = Model.Settlement ? 9 : 8;
}
<table class="fanex-result">
    <thead>
        @if (Model.IsShowTitle && Model.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.HockeyViewModel)Model.Data[0];
            <tr class="row-title">
                <th class="column-title" colspan="@colspan">
                    <span class="sport">@item.GetSportName((int)Model.SportType)</span> &nbsp;-&nbsp;
                    <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="row-header">
            <th class="column-kickofftime">
                @lang.KickOffTime
            </th>
            <th class="column-match">
                @Raw(lang.Match)
            </th>
            <th class="column-1p">
                @lang.Lbl1P
            </th>
            <th class="column-2p">
                @lang.Lbl2P
            </th>
            <th class="column-3p">
                @lang.Lbl3P
            </th>
            <th class="column-ot">
                @lang.LblOT
            </th>
            <th class="column-finalscore">
                @lang.FinalScore
            </th>
            <th class="column-status">
                @lang.Status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in Model.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.HockeyViewModel)itemObj;
                index++;
                if (!Model.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;

            <tr class="row-data">
                <td colspan="@colspan" class="column-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }

            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-kickofftime" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="column-match">
                    @Raw(item.HomeTeam)
                </td>
                <td class="column-1p">
                    @item.GetHomeAwaySet(0, true)
                </td>
                <td class="column-2p">
                    @item.GetHomeAwaySet(1, true)
                </td>
                <td class="column-3p">
                    @item.GetHomeAwaySet(2, true)
                </td>
                <td class="column-ot">
                    @item.OTHome
                </td>
                <td char="column-final-homescore">
                    @item.FinalHomeScore
                </td>
                <td rowspan="2" class="column-eventstatus">
                    @item.EventStatus
                </td>
            </tr>
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-match">
                    @Raw(item.AwayTeam)
                </td>
                <td class="column-1p">
                    @item.GetHomeAwaySet(0, false)
                </td>
                <td class="column-2p">
                    @item.GetHomeAwaySet(1, false)
                </td>
                <td class="column-3p">
                    @item.GetHomeAwaySet(2, false)
                </td>
                <td class="column-ot">
                    @item.OTAway
                </td>
                <td class="column-ht-finalscore">
                    @item.FinalAwayScore
                </td>
            </tr>

            }

        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @Model.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>