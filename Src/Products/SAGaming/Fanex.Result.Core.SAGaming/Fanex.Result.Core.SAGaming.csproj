    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Fanex.Result.Core.SAGaming</AssemblyTitle>
    <Product>Fanex.Result.Core.SAGaming</Product>
    <Copyright>Copyright ©  2016</Copyright>
    <Version>3.0.0.0-upgrade-01</Version>
