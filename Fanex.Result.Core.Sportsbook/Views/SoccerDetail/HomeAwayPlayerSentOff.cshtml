@{
    var itemViewModel = (Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerDetailViewModel)Model;

    var lang = (Fanex.Result.Core.Base.DataDomain.LangResources)itemViewModel.Resource;

}
@using Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo;
@using Fanex.Result.Core.Sportsbook.ViewModels;
@using System.Collections;
<tr class="data">
    <td colspan="3" class="cl-league sub">
        @itemViewModel.Name
    </td>
</tr>
<!--Merge row-->
@{
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem homePlayerSentOff1H = null;
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem awayPlayerSentOff1H = null;
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem homePlayerSentOff = null;
    Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo.SoccerGameDetailItem awayPlayerSentOff = null;
    var firstHalfResource = string.Empty;
    var fullTimeResource = string.Empty;
}
@foreach (var item in itemViewModel.DetailItems)
{
    switch (item.ResourceID)
    {
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.HomePlayserSentOff:
            fullTimeResource = item.ResourceName;
            homePlayerSentOff = item;
            break;
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.AwayPlayserSentOff:
            fullTimeResource = item.ResourceName;
            awayPlayerSentOff = item;
            break;
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.HomePlayserSentOff1H:
            firstHalfResource = item.ResourceName;
            homePlayerSentOff1H = item;
            break;
        case Fanex.Result.Core.Sportsbook.DataDomain.GameResourceID.AwayPlayserSentOff1H:
            firstHalfResource = item.ResourceName;
            awayPlayerSentOff1H = item;
            break;
    }
}
<!--Assign "-" value in case it's value is null or empty-->
@if (homePlayerSentOff1H != null || homePlayerSentOff1H != null)
{
    <tr class="data">
        <td class="cl-match">
            @firstHalfResource
        </td>
        <td class="cl-result home">
            @if (homePlayerSentOff1H == null || string.IsNullOrEmpty(homePlayerSentOff1H.HomeValue))
            {
                @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @homePlayerSentOff1H.HomeValue
            }
        </td>
        <td class="cl-result away">
            @if (awayPlayerSentOff1H == null || string.IsNullOrEmpty(awayPlayerSentOff1H.HomeValue))
            {
                 @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @awayPlayerSentOff1H.HomeValue
            }
        </td>
    </tr>
}
@if (homePlayerSentOff != null || awayPlayerSentOff != null)
{
    <tr class="data">
        <td class="cl-match">
            @fullTimeResource
        </td>
        <td class="cl-result home">
            @if (homePlayerSentOff == null || string.IsNullOrEmpty(homePlayerSentOff.HomeValue))
            {
                @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @homePlayerSentOff.HomeValue
            }
        </td>
        <td class="cl-result away">
            @if (awayPlayerSentOff == null || string.IsNullOrEmpty(awayPlayerSentOff.HomeValue))
            {
                @Fanex.Result.Core.Base.DataDomain.ConstantValue.Hyphen
            }
            else
            {
                @awayPlayerSentOff.HomeValue
            }
        </td>
    </tr>
}