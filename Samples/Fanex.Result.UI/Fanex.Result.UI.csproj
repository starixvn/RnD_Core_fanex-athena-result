<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fanex.Result.UI</RootNamespace>
    <AssemblyName>Fanex.Result.UI</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseIISExpress>false</UseIISExpress>
    <IISExpressSSLPort />
    <IISExpressAnonymousAuthentication />
    <IISExpressWindowsAuthentication />
    <IISExpressUseClassicPipelineMode />
    <UseGlobalApplicationHostFile />
    <Use64BitIISExpress />
  </PropertyGroup>

  <PropertyGroup>
    <!-- Exclude the project from analysis -->
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Content\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="App_Data\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="web.config" />
    <Content Include="web.Debug.config" />
    <Content Include="web.Release.config" />
    <Content Include="Fanex.Result.UI.ruleset" />
    <Content Include="compilerconfig.json" />
    <Content Include="compilerconfig.json.defaults" />
    <Content Include="Fanex.Result.UI.licenseheader" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="..\..\packages\SonarAnalyzer.CSharp.7.8.0.7320\analyzers\Google.Protobuf.dll" />
    <Analyzer Include="..\..\packages\SonarAnalyzer.CSharp.7.8.0.7320\analyzers\SonarAnalyzer.CSharp.dll" />
    <Analyzer Include="..\..\packages\SonarAnalyzer.CSharp.7.8.0.7320\analyzers\SonarAnalyzer.dll" />
  </ItemGroup>

</Project>