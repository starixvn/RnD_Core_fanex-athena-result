@using Fanex.Result.Core.Base.Resources;
@using Fanex.Result.Core.Base.ViewModels;
@using Fanex.Result.Core.Sportsbook.ViewModels;

@{
    var viewModel = (RazorBinderModel)Model;

    var popupCss = viewModel.IsPopUp || viewModel.IsDetail ? "popup" : string.Empty;
    var firstMatch = viewModel.Data.Count > 0 ? (SoccerViewModel)viewModel.Data[0].Data[0] : null;
    var colspan = viewModel.VisibleMatchCodeIDColumn ? 6 : 5;
    colspan += firstMatch != null && firstMatch.IsShowLiveScore ? 1 : 0;
}

@helper RenderHeader(RazorBinderModel viewModel, SoccerViewModel firstMatch, int colspan)
{
    <thead>
        @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
        {
            <tr class="row-title">
                <th class="cl-title" colspan="@colspan">
                    <span class="sport">@firstMatch.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@firstMatch.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="header">
            @if (viewModel.VisibleMatchCodeIDColumn)
            {
                <th class="cl-m-code">@LangResource.MatchCode/@LangResource.ID</th>
            }
            <th class="cl-ko-time">@LangResource.KickOffTime</th>
            <th class="cl-match">@LangResource.Match</th>
            <th class="cl-ht-score">@LangResource.HTScore</th>
            <th class="cl-f-score">@LangResource.FinalScore</th>
            @if (firstMatch.IsShowLiveScore)
            {
                <th class="cl-f-score">@LangResource.LiveScore</th>
            }
            <th class="cl-status">@LangResource.Status</th>
        </tr>
    </thead>
}

@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs @popupCss">
            @RenderHeader(viewModel, firstMatch, colspan)
        </table>
    </div>
}

@if (viewModel.VisibleFreeHeader)
{
    @Raw("<div class=\"fn-rs-content-scroll\">")
}
<table class="fn-rs @popupCss">
    @if (!viewModel.VisibleFreeHeader)
    {
        @RenderHeader(viewModel, firstMatch, colspan)
    }
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var index = 0;
            foreach (var group in viewModel.Data)
            {
                if (!viewModel.IsPopUp)
                {

                    <tr class="data">
                        <td colspan="@colspan" class="cl-league">@group.Data[0].LeagueName</td>
                    </tr>
                }

                foreach (SoccerViewModel item in group.Data)
                {
                    index++;
                    <tr class="data @item.Color(index, "even", "odd")">
                        @if (viewModel.VisibleMatchCodeIDColumn)
                        {
                            <td class="cl-m-code">
                                <div class="m-code">@item.MatchCode</div>
                            </td>
                        }
                        <td class="cl-ko-time" rowspan="2">@Raw(item.KickOffTime)</td>
                        <td class="cl-match home @item.HomeWin">
                            @Raw(item.HomeTeam) &nbsp;
                            @if (item.IsShowFGHome)
                            {
                                <div class="first-goal">&nbsp;</div>
                            }
                            @if (item.IsShowLGHome)
                            {
                                <div class="last-goal">&nbsp;</div>
                            }
                            @if (item.IsShowedFirstHalfFGHome)
                            {
                                <div class="first-half-first-goal">&nbsp;</div>
                            }
                            @if (item.IsShowedFirstHalfLGHome)
                            {
                                <div class="first-half-last-goal">&nbsp;</div>
                            }
                        </td>
                        <td class="cl-ht-score">@item.HTHomeScore</td>
                        <td class="cl-f-score">@item.FinalHomeScore</td>
                        @if (firstMatch.IsShowLiveScore)
                        {
                            <td class="cl-f-score">@item.LiveHomeScore</td>
                        }
                        <td rowspan="2" class="cl-status @item.EventStatusBackground">
                            <div>@item.EventStatus</div>
                            @if (item.VisibleDetailedLink && !viewModel.IsPopUp)
                            {
                                <div>
                                    <span class="detail-link" data-match-id="@item.MatchId" data-league-id="@item.LeagueId" data-home-id="@item.HomeId" data-away-id="@item.AwayId">
                                        @LangResource.Details
                                    </span>
                                </div>
                            }
                        </td>
                    </tr>
                    <tr class="data @item.Color(index, "even", "odd")">
                        @if (viewModel.VisibleMatchCodeIDColumn)
                        {
                            <td class="cl-m-code">@item.MatchId</td>
                        }
                        <td class="cl-match away @item.AwayWin">
                            @Raw(item.AwayTeam) &nbsp;
                            @if (item.IsShowFGAway)
                            {
                                <div class="first-goal">&nbsp;</div>
                            }
                            @if (item.IsShowLGAway)
                            {
                                <div class="last-goal">&nbsp;</div>
                            }
                            @if (item.IsShowedFirstHalfFGAway)
                            {
                                <div class="first-half-first-goal">&nbsp;</div>
                            }
                            @if (item.IsShowedFirstHalfLGAway)
                            {
                                <div class="first-half-last-goal">&nbsp;</div>
                            }
                        </td>
                        <td class="cl-ht-score">@item.HTAwayScore</td>
                        <td class="cl-f-score">@item.FinalAwayScore</td>
                        @if (firstMatch.IsShowLiveScore)
                        {
                            <td class="cl-f-score">@item.LiveAwayScore</td>
                        }
                    </tr>
                }
            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">@LangResource.NoInfo</td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}
@if (viewModel.VisibleDetailResult)
{
    var mainItem = viewModel.Data[0].Data[0] as SoccerViewModel;
    var gameResult = mainItem.DetailedResult;
    if (mainItem.VisibleGoalRecord)
    {
        var homeScore = 0;
        var awayScore = 0;

        <div class="goal-record">
            <table>
                <thead>
                    <tr class="header">
                        <th class="cl-goal" colspan="2">@LangResource.GoalRecord</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var goal in mainItem.GoalRecord)
                    {
                        var goalLower = char.ToLower(goal);
                        homeScore += 'h' == goalLower ? 1 : 0;
                        awayScore += 'a' == goalLower ? 1 : 0;
                        <tr class="data">
                            <td class="cl-goal">@homeScore - @awayScore</td>
                            <td class="cl-goal">@(Equals('h', goalLower) ? LangResource.Home : LangResource.Away)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    if (!string.IsNullOrEmpty(gameResult))
    {
        <br />
        <table class="fn-rs popup">
            <thead>
                <tr class="header">
                    <th class="cl-match">@LangResource.MoreResults</th>
                    <th class="cl-result home">@mainItem.HomeTeam</th>
                    <th class="cl-result away">@mainItem.AwayTeam</th>
                </tr>
            </thead>
            <tbody>
                @Raw(gameResult)
            </tbody>
        </table>
    }
}