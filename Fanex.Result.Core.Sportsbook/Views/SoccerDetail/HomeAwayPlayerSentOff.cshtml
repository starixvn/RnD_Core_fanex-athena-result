@using Fanex.Result.Core.Sportsbook.ViewModels.SoccerInfo;
@using Fanex.Result.Core.Sportsbook.DataDomain;
@using Fanex.Result.Core.Base.DataDomain;
@{
    var itemViewModel = (SoccerDetailViewModel)Model;
}
<tr class="data cl-group-name">
    <td></td>
    <td colspan="2">@itemViewModel.Name</td>
</tr>
<!--Merge row-->
@{
    SoccerGameDetailItem homePlayerSentOff1H = null;
    SoccerGameDetailItem awayPlayerSentOff1H = null;
    SoccerGameDetailItem homePlayerSentOff = null;
    SoccerGameDetailItem awayPlayerSentOff = null;
    var firstHalfResource = string.Empty;
    var fullTimeResource = string.Empty;
}
@foreach (var item in itemViewModel.DetailItems)
{
    switch (item.ResourceID)
    {
        case GameResourceID.HomePlayserSentOff:
            fullTimeResource = item.ResourceName;
            homePlayerSentOff = item;
            break;
        case GameResourceID.AwayPlayserSentOff:
            fullTimeResource = item.ResourceName;
            awayPlayerSentOff = item;
            break;
        case GameResourceID.HomePlayserSentOff1H:
            firstHalfResource = item.ResourceName;
            homePlayerSentOff1H = item;
            break;
        case GameResourceID.AwayPlayserSentOff1H:
            firstHalfResource = item.ResourceName;
            awayPlayerSentOff1H = item;
            break;
    }
}
<!--Assign "-" value in case it's value is null or empty-->
@if (homePlayerSentOff1H != null || awayPlayerSentOff1H != null)
{
    <tr class="data">
        <td class="cl-match">
            @firstHalfResource
        </td>
        <td class="cl-result home">
            @if (homePlayerSentOff1H == null || string.IsNullOrEmpty(homePlayerSentOff1H.HomeValue))
            {
                @ConstantValue.Hyphen
            }
            else
            {
                @homePlayerSentOff1H.HomeValue
            }
        </td>
        <td class="cl-result away">
            @if (awayPlayerSentOff1H == null || string.IsNullOrEmpty(awayPlayerSentOff1H.HomeValue))
            {
                 @ConstantValue.Hyphen
            }
            else
            {
                @awayPlayerSentOff1H.HomeValue
            }
        </td>
    </tr>
}
@if (homePlayerSentOff != null || awayPlayerSentOff != null)
{
    <tr class="data">
        <td class="cl-match">
            @fullTimeResource
        </td>
        <td class="cl-result home">
            @if (homePlayerSentOff == null || string.IsNullOrEmpty(homePlayerSentOff.HomeValue))
            {
                @ConstantValue.Hyphen
            }
            else
            {
                @homePlayerSentOff.HomeValue
            }
        </td>
        <td class="cl-result away">
            @if (awayPlayerSentOff == null || string.IsNullOrEmpty(awayPlayerSentOff.HomeValue))
            {
                @ConstantValue.Hyphen
            }
            else
            {
                @awayPlayerSentOff.HomeValue
            }
        </td>
    </tr>
}