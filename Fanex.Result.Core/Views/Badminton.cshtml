@{
    var lang = (Fanex.Result.Core.DTO.LangResources)Model.Resource;
    const int colspan = 10;
}
<table class="fanex-result">
    <thead>
        @if (Model.IsShowTitle && Model.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.BadmintonViewModel)Model.Data[0];
            <tr class="row-title">
                <th class="column-title" colspan="@colspan">
                    <span class="sport">@item.SportName</span> &nbsp;-&nbsp;
                    <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="row-header">
            <th class="column-kickofftime">
                @lang.KickOffTime
            </th>
            <th class="column-match">
                @Raw(lang.Match)
            </th>
            <th class="column-1s">
                @lang.Lbl1S
            </th>
            <th class="column-2s">
                @lang.Lbl2S
            </th>
            <th class="column-3s">
                @lang.Lbl3S
            </th>
            <th class="column-4s">
                @lang.Lbl4S
            </th>
            <th class="column-5s">
                @lang.Lbl5S
            </th>
            <th class="column-totalgames">
                @lang.TotalPoints
            </th>
            <th class="column-totalset">
                @lang.TotalSet
            </th>
            <th class="column-status">
                @lang.Status
            </th>
        </tr>
    </thead>
    <tbody>
        <!--RowData-->
        @if (Model.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in Model.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.BadmintonViewModel)itemObj;
                index++;
                if (!Model.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;

            <tr class="row-data">
                <td colspan="@colspan" class="column-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-kickofftime" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="column-match">
                    @Raw(item.HomeTeam)
                </td>
                <td class="column-1s">
                    @item.GetHomeAwaySet(0, true)
                </td>
                <td class="column-2s">
                    @item.GetHomeAwaySet(1, true)
                </td>
                <td class="column-3s">
                    @item.GetHomeAwaySet(2, true)
                </td>
                <td class="column-4s">
                    @item.GetHomeAwaySet(3, true)
                </td>
                <td class="column-5s">
                    @item.GetHomeAwaySet(4, true)
                </td>
                <td class="column-totalgames">
                    @item.TotalPointHome
                </td>
                <td class="column-totalset">
                    @item.TotalSetHome
                </td>
                <td rowspan="2" class="column-eventstatus">
                    @item.EventStatus
                </td>
            </tr>
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-match">
                    @Raw(item.AwayTeam)
                </td>
                <td class="column-1s">
                    @item.GetHomeAwaySet(0, false)
                </td>
                <td class="column-2s">
                    @item.GetHomeAwaySet(1, false)
                </td>
                <td class="column-3s">
                    @item.GetHomeAwaySet(2, false)
                </td>
                <td class="column-4s">
                    @item.GetHomeAwaySet(3, false)
                </td>
                <td class="column-5s">
                    @item.GetHomeAwaySet(4, false)
                </td>
                <td class="column-totalgames">
                    @item.TotalPointAway
                </td>
                <td class="column-totalset">
                    @item.TotalSetAWay
                </td>
            </tr>

            }
            <!--/RowData-->
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @Model.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>