@{
    var viewModel = (Fanex.Result.Core.Models.RazorBinderModel)Model;
    var lang = (Fanex.Result.Core.DataDomain.LangResources)viewModel.Resource;
    var colspan = viewModel.VisibleMatchCodeIDColumn ? 16 : 15;
}
@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs">
            <thead>
                @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
                {
                    var item = (Fanex.Result.Core.ViewModels.BaseBallViewModel)viewModel.Data[0];
                    <tr class="row-title">
                        <th class="cl-title" colspan="@colspan">
                            <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                        </th>
                    </tr>
                }
                <tr class="header">
                    @if (viewModel.VisibleMatchCodeIDColumn)
                    {
                        <th class="cl-m-code">
                            @lang.MatchCode/@lang.ID
                        </th>
                    }
                    <th class="cl-ko-time">
                        @lang.KickOffTime
                    </th>
                    <th class="cl-match home">
                        @Raw(lang.Match)
                    </th>
                    <th class="cl-n">
                        1
                    </th>
                    <th class="cl-n">
                        2
                    </th>
                    <th class="cl-n">
                        3
                    </th>
                    <th class="cl-n">
                        4
                    </th>
                    <th class="cl-n">
                        5
                    </th>
                    <th class="cl-n">
                        6
                    </th>
                    <th class="cl-n">
                        7
                    </th>
                    <th class="cl-n">
                        8
                    </th>
                    <th class="cl-n">
                        9
                    </th>
                    <th class="cl-ei">
                        E.I
                    </th>
                    <th class="cl-ht-core">
                        @Raw(lang.FirstHalfScore)
                    </th>
                    <th class="cl-f-score">
                        @lang.FinalScore
                    </th>
                    <th class="cl-status">
                        @lang.Status
                    </th>
                </tr>
            </thead>
        </table>
    </div>
}
@if (viewModel.VisibleFreeHeader)
{
    @Raw("<div class=\"fn-rs-content-scroll\">")

}
<table class="fn-rs">
    @if (!viewModel.VisibleFreeHeader)
    {
        <thead>
            @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
            {
                var item = (Fanex.Result.Core.ViewModels.BaseBallViewModel)viewModel.Data[0];
                <tr class="row-title">
                    <th class="cl-title" colspan="@colspan">
                        <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                    </th>
                </tr>
            }
            <tr class="header">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <th class="cl-m-code">
                        @lang.MatchCode/@lang.ID
                    </th>
                }
                <th class="cl-ko-time">
                    @lang.KickOffTime
                </th>
                <th class="cl-match home">
                    @Raw(lang.Match)
                </th>
                <th class="cl-n">
                    1
                </th>
                <th class="cl-n">
                    2
                </th>
                <th class="cl-n">
                    3
                </th>
                <th class="cl-n">
                    4
                </th>
                <th class="cl-n">
                    5
                </th>
                <th class="cl-n">
                    6
                </th>
                <th class="cl-n">
                    7
                </th>
                <th class="cl-n">
                    8
                </th>
                <th class="cl-n">
                    9
                </th>
                <th class="cl-ei">
                    E.I
                </th>
                <th class="cl-ht-core">
                    @Raw(lang.FirstHalfScore)
                </th>
                <th class="cl-f-score">
                    @lang.FinalScore
                </th>
                <th class="cl-status">
                    @lang.Status
                </th>
            </tr>
        </thead>
    }
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in viewModel.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.BaseBallViewModel)itemObj;
                index++;
                if (!viewModel.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;

            <tr class="data">
                <td colspan="@colspan" class="cl-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }

            <tr class="data @item.Color(index, "even", "odd")">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <td class="cl-m-code">
                        <div class="m-code">
                            @item.MatchCode
                        </div>
                    </td>
                }
                <td class="cl-ko-time" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="cl-match away">
                    @Raw(item.HomeTeam)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(0, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(1, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(2, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(3, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(4, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(5, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(6, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(7, true)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(8, true)
                </td>
                <td class="cl-ei">
                    @item.EIHome
                </td>
                <td class="cl-ht-core">
                    @item.HTHomeScore
                </td>
                <td class="cl-f-score">
                    @item.FinalHomeScore
                </td>
                <td rowspan="2" class="cl-status">
                    @item.EventStatus
                </td>
            </tr>
            <tr class="data @item.Color(index, "even", "odd")">
                @if (viewModel.VisibleMatchCodeIDColumn)
                {
                    <td class="cl-m-code">
                        @item.MatchId
                    </td>
                }
                <td class="cl-match">
                    @Raw(item.AwayTeam)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(0, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(1, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(2, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(3, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(4, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(5, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(6, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(7, false)
                </td>
                <td class="cl-n">
                    @item.GetHomeAwaySet(8, false)
                </td>
                <td class="cl-ei">
                    @item.EIAway
                </td>
                <td class="cl-ht-core">
                    @item.HTAwayScore
                </td>
                <td class="cl-f-score">
                    @item.FinalAwayScore
                </td>
            </tr>

            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}