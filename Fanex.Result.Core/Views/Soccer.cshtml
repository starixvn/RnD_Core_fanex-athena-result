@{
    var lang = (Fanex.Result.Core.DTO.LangResources)Model.Resource;
    const int colspan = 5;
}
<table class="fanex-result">
    <thead>
        @if (Model.IsShowTitle && Model.Data.Count > 0)
        {
            var item = (Fanex.Result.Core.ViewModels.SoccerViewModel)Model.Data[0];
            <tr class="row-title">
                <th class="column-title" colspan="@colspan">
                    <span class="sport">@item.GetSportName((int)Model.SportType)</span> &nbsp;-&nbsp;
                    <span class="leagueName">@item.LeagueName</span>
                </th>
            </tr>
        }
        <tr class="row-header">
            <th class="column-kickofftime">
                @lang.KickOffTime
            </th>
            <th class="column-match">
                @Raw(lang.Match)
            </th>
            <th class="column-firsthaftscore">
                @Raw(lang.FirstHalfScore)
            </th>
            <th class="column-finalscore">
                @lang.FinalScore
            </th>
            <th class="column-status">
                @lang.Status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var index = 0;
            foreach (var itemObj in Model.Data)
            {
                var item = (Fanex.Result.Core.ViewModels.SoccerViewModel)itemObj;
                index++;
                if (!Model.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    if (currentLeagueId == 0 || currentLeagueId != leagueId)
                    {
                        currentLeagueId = leagueId;

            <tr class="row-data">
                <td colspan="@colspan" class="column-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-kickofftime" rowspan="2">
                    @Raw(item.KickOffTime)
                </td>
                <td class="column-match">
                    @Raw(item.HomeTeam) &nbsp;
                    @if (item.IsShowFGHome)
                    {
                        <div class="first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowLGHome)
                    {
                        <div class="last-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfFGHome)
                    {
                        <div class="first-half-first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfLGHome)
                    {
                        <div class="first-half-last-goal">
                            &nbsp;</div>
                    }
                </td>
                <td class="column-ht-homescore">
                    @item.HTHomeScore
                </td>
                <td class="column-final-homescore">
                    @item.FinalHomeScore
                </td>
                <td rowspan="2" class="column-eventstatus">
                    @item.EventStatus
                </td>
            </tr>
            <tr class="row-data @item.Color(index, "format-even", "format-odd")">
                <td class="column-match">
                    @Raw(item.AwayTeam) &nbsp;
                    @if (item.IsShowFGAway)
                    {
                        <div class="first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowLGAway)
                    {
                        <div class="last-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfFGAway)
                    {
                        <div class="first-half-first-goal">
                            &nbsp;</div>
                    }
                    @if (item.IsShowedFirstHalfLGAway)
                    {
                        <div class="first-half-last-goal">
                            &nbsp;</div>
                    }
                </td>
                <td class="column-ht-awayscore">
                    @item.HTAwayScore
                </td>
                <td class="column-ht-finalscore">
                    @item.FinalAwayScore
                </td>
            </tr>

            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @Model.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>