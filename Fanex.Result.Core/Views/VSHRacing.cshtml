@{
    var viewModel = (Fanex.Result.Core.Models.RazorBinderModel)Model;

    var lang = (Fanex.Result.Core.DataDomain.LangResources)viewModel.Resource;
    const int colspan = 7;
}
@if (viewModel.VisibleFreeHeader)
{
    <div class="fn-rs-content-header">
        <table class="fn-rs">
            <thead>
                @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
                {
                    var item = (Fanex.Result.Core.ViewModels.VSHRacingViewModel)viewModel.Data[0];
                    <tr class="row-title">
                        <th class="cl-title" colspan="@colspan">
                            <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                        </th>
                    </tr>
                }
                <tr class="header">
                    <th class="cl-race" colspan="3">
                        @lang.Race
                    </th>
                    <th class="cl-result">
                        @Raw(lang.Result)
                    </th>
                    <th class="cl-win">
                        @Raw(lang.Win)
                    </th>
                    <th class="cl-plae">
                        @Raw(lang.Place)
                    </th>
                    <th class="cl-status">
                        @lang.Status
                    </th>
                </tr>
            </thead>
        </table>
    </div>
}
@if (viewModel.VisibleFreeHeader)
{
    @Raw("<div class=\"fn-rs-content-scroll\">")

}
<table class="fn-rs">
    @if (!viewModel.VisibleFreeHeader)
    {

        <thead>
            @if (viewModel.VisiblePopUpTitle && viewModel.Data.Count > 0)
            {
                var item = (Fanex.Result.Core.ViewModels.VSHRacingViewModel)viewModel.Data[0];
                <tr class="row-title">
                    <th class="cl-title" colspan="@colspan">
                        <span class="sport">@item.SportName</span> &nbsp;-&nbsp; <span class="leagueName">@item.LeagueName</span>
                    </th>
                </tr>
            }
            <tr class="header">
                <th class="cl-race" colspan="3">
                    @lang.Race
                </th>
                <th class="cl-result">
                    @Raw(lang.Result)
                </th>
                <th class="cl-win">
                    @Raw(lang.Win)
                </th>
                <th class="cl-plae">
                    @Raw(lang.Place)
                </th>
                <th class="cl-status">
                    @lang.Status
                </th>
            </tr>
        </thead>
    }
    <tbody>
        @if (viewModel.Data.Count > 0)
        {
            var currentLeagueId = 0;
            var currentRace = DateTime.MinValue;
            var newLeague = false;
            for (int index = 0, j = viewModel.Data.Count; index < j; index++)
            {
                var item = (Fanex.Result.Core.ViewModels.VSHRacingViewModel)viewModel.Data[index];
                if (item.Place > 4) { continue; }

                if (!viewModel.IsPopUp)
                {
                    var leagueId = item.LeagueId;
                    newLeague = currentLeagueId == 0 || currentLeagueId != leagueId;
                    if (newLeague)
                    {
                        currentLeagueId = leagueId;

            <tr class="data">
                <td colspan="@colspan" class="cl-league">
                    @item.LeagueName
                </td>
            </tr>
                    }
                }

                if (newLeague || currentRace != item.EvenTime)
                {
                    currentRace = item.EvenTime;
                    var counter = 0;
            <tr class="data @item.Color(index, "even", "odd")">
                <td class="cl-race-name" rowspan="@item.RowCount">
                    @Raw(item.KickOffTime)
                </td>
                <td class="cl-placeing">
                    @item.Placing
                </td>
                <td class="cl-engine-no">
                    @item.HorseNo
                </td>
                <td class="cl-result home">
                    @item.Result
                </td>
                <td class="cl-win home">
                    @item.WinOdd
                </td>
                <td class="cl-place home">
                    @item.PlaceOdd
                </td>
                <td class="cl-status">
                    @item.Status
                </td>
            </tr>

                }
                else
                {
            <tr class="data @item.Color(index, "even", "odd")">
                <td class="cl-placeing">
                    @item.Placing
                </td>
                <td class="cl-engine-no">
                    @item.HorseNo
                </td>
                <td class="cl-result away">
                    @item.Result
                </td>
                <td class="cl-win away">
                    @item.WinOdd
                </td>
                <td class="cl-place away">
                    @item.PlaceOdd
                </td>
                <td class="cl-status away">
                    @item.Status
                </td>
            </tr>
                }

            }
        }
        else
        {
            <!--NoInfo-->
            <tr class="row-noinfo">
                <td colspan="@colspan">
                    @viewModel.Resource.NoInfo
                </td>
            </tr>
            <!--/NoInfo-->
        }
    </tbody>
</table>
@if (viewModel.VisibleFreeHeader)
{
    @Raw("</div>")
}